{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "../dist/shared",
    "rootDir": "."
  },
  "include": ["*.ts"],
  "exclude": ["**/*.test.ts", "node_modules"]
}