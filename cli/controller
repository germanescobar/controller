// Exposed for tests: only auto-run `main()` when this file is the script the
// process was launched as, so unit tests can import the helpers without
// triggering CLI parsing against the test runner's argv.
import { pathToFileURL } from "node:url";
export const isMain =
  process.argv[1] !== undefined &&
  import.meta.url === pathToFileURL(process.argv[1]).href;

function fail(message) {
  process.stderr.write(`Error: ${message}\n`);
  process.exit(1);
}

// Compose the single line `fail()` prints from a server JSON error body.
//
// Every server error body carries `error` (the historical one-line text).
// Since issue #367 a body may also carry `hint` with the actionable next
// step — e.g. a 404 from a `worktreeId` route that recognized the value
// as a *project* id says so and points at `worktrees list`. Call sites
// used to spell this as `fail(result?.error ?? fallback)`, which threw
// the hint away; they go through here instead so the hint is appended to
// the same line rather than lost.
export function serverError(result, fallback) {
  const base =
    typeof result?.error === "string" && result.error.trim()
      ? result.error.trim()
      : fallback;
  const hint = typeof result?.hint === "string" ? result.hint.trim() : "";
  if (!hint) return base;
  return /[.!?]$/.test(base) ? `${base} ${hint}` : `${base}. ${hint}`;
}

async function getServerUrl() {
  if (process.env.CONTROLLER_SERVER_URL) return process.env.CONTROLLER_SERVER_URL;
  const os = await import("node:os");
  const path = await import("node:path");
  const fs = await import("node:fs/promises");

  const candidates = [];
  // 1. Sibling to the installed CLI script (most robust handle — survives
  //    env-stripping providers and works regardless of the home's location).
  try {
    const scriptPath = await fs.realpath(process.argv[1]);
    candidates.push(path.join(path.dirname(scriptPath), "..", "controller-runtime.json"));
  } catch {}
  // 2. Explicit CONTROLLER_HOME override.
  const overrideHome = process.env.CONTROLLER_HOME?.trim();
  if (overrideHome) {
    candidates.push(path.join(overrideHome, "controller-runtime.json"));
  }
  // 3. Platform-default home (issue #223): macOS `Application Support`,
  //    Linux `XDG_STATE_HOME`, otherwise the legacy top-level dot-less dir.
  candidates.push(defaultHomeRuntimeFile(os, path));

  for (const candidate of candidates) {
    try {
      const parsed = JSON.parse(await fs.readFile(candidate, "utf-8"));
      if (parsed && typeof parsed.serverUrl === "string") return parsed.serverUrl;
    } catch {}
  }
  fail("Could not determine the Controller server URL. Is the Controller app running?");
}

// Mirror of `defaultHomeForPlatform` in `server/lib/paths.ts`. The CLI runs
// outside the server process (it may be invoked from a sanitized agent
// shell), so it can't import the server module and re-implements the
// resolution here. Keep the two in sync.
function defaultHomeRuntimeFile(os, path) {
  const platform = process.platform;
  if (platform === "darwin") {
    return path.join(
      os.homedir(),
      "Library",
      "Application Support",
      "Controller",
      "controller-runtime.json",
    );
  }
  if (platform === "linux") {
    const xdg = process.env.XDG_STATE_HOME?.trim();
    const base = xdg && xdg !== "" ? xdg : path.join(os.homedir(), ".local", "state");
    return path.join(base, "Controller", "controller-runtime.json");
  }
  return path.join(
    os.homedir(),
    "coding-orchestrator",
    "controller-runtime.json",
  );
}

async function postJson(serverUrl, route, body) {
  let response;
  try {
    response = await fetch(`${serverUrl.replace(/\/$/, "")}${route}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ ...body, cwd: process.cwd() }),
    });
  } catch (error) {
    fail(`Could not reach the orchestrator: ${error?.message ?? error}`);
  }
  let result;
  try {
    result = await response.json();
  } catch {
    fail(`Unexpected response (HTTP ${response.status})`);
  }
  return { response, result };
}

// PUT counterpart of `postJson` — used for resources where the verb
// carries meaning (issue #339: `sessions goal` distinguishes set from
// clear via the body's `action` field, but the wire verb still says
// PUT so an HTTP-aware client can route correctly). The body shape
// matches `postJson`, including the auto-attached `cwd`.
async function putJson(serverUrl, route, body) {
  let response;
  try {
    response = await fetch(`${serverUrl.replace(/\/$/, "")}${route}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ ...body, cwd: process.cwd() }),
    });
  } catch (error) {
    fail(`Could not reach the orchestrator: ${error?.message ?? error}`);
  }
  let result;
  try {
    result = await response.json();
  } catch {
    fail(`Unexpected response (HTTP ${response.status})`);
  }
  return { response, result };
}

// Server route handlers use method-specific verbs (DELETE for worktree
// removal, etc.), so callers that don't fit the JSON-POST shape need their
// own helper. `runWorktrees delete` goes through here instead of
// `postJson` so the wire request matches `server/routes/worktrees.ts:788`.
async function deleteJson(serverUrl, route) {
  let response;
  try {
    response = await fetch(`${serverUrl.replace(/\/$/, "")}${route}`, {
      method: "DELETE",
    });
  } catch (error) {
    fail(`Could not reach the orchestrator: ${error?.message ?? error}`);
  }
  let result = null;
  // Some DELETE handlers return no body; treat empty/invalid JSON as
  // success-shape and only fail when we have a parsed object with `error`.
  const raw = await response.text();
  if (raw) {
    try {
      result = JSON.parse(raw);
    } catch {
      result = null;
    }
  }
  return { response, result };
}

// --- project resolver (issue #190) ---
//
// `<project>` in the worktrees / sessions surfaces accepts either a project
// id (UUID) or the project's human name. We fetch the project list once and
// match in JS so the server doesn't need a name-lookup endpoint just to make
// the CLI more human-friendly.
//
// When `<project>` is omitted (or doesn't match by id/name), we also try
// resolving by the agent's `cwd` against `GET /api/projects?cwd=...`. The
// orchestrator already thinks of a session as "pinned to a worktree owned
// by a project rooted at `project.path`", so mapping a shell cwd back to
// its project is the obvious next step — agents no longer have to memorize
// a project name or id to run `worktrees create` from a worktree shell.
export async function resolveProjectId(serverUrl, ref) {
  // Try the supplied ref by id / name first. If it matches, use that
  // match — explicit user input wins over cwd-based heuristics.
  if (ref) {
    const projects = await fetchProjectList(serverUrl);
    const match = projects.find((p) => p && p.id === ref);
    if (match) return match.id;
    const byName = projects.find((p) => p && p.name === ref);
    if (byName) return byName.id;
    // No id/name match — fall through to the cwd-based lookup. The
    // agent is almost always in a worktree of the project they want;
    // silently using the cwd-resolved project is the whole point of
    // this fallback (a typo'd name shouldn't make `worktrees create`
    // fail when the orchestrator already knows what project the
    // session is in).
  }
  const cwd = process.cwd();
  const fromCwd = await resolveProjectByCwd(serverUrl, cwd);
  if (fromCwd) return fromCwd.id;
  // Final miss: surface a useful error. If the user supplied a ref
  // and we couldn't match it, name the cwd in the error so they
  // understand both halves of the failure.
  if (ref) {
    fail(
      `No project matches "${ref}" (and cwd ${cwd} is not part of any onboarded project). ` +
        `Pass the project's id (UUID) or its human name, or onboard the project first.`
    );
  }
  fail(
    `Could not determine the current project from cwd ${cwd} ` +
      `(no project owns this path). Pass the project id or name explicitly, ` +
      `or run from inside a project that's been onboarded via Controller.`
  );
}

// Fetch the project list once and reuse it for id/name matching. Kept
// separate from `resolveProjectId` so the test suite can stub just the
// project list without exercising the cwd fallback path.
export async function fetchProjectList(serverUrl) {
  const url = `${serverUrl.replace(/\/$/, "")}/api/projects`;
  let response;
  try {
    response = await fetch(url);
  } catch (error) {
    fail(`Could not reach the orchestrator: ${error?.message ?? error}`);
  }
  if (response.status >= 400) {
    fail(`Failed to list projects (HTTP ${response.status})`);
  }
  let projects;
  try {
    projects = await response.json();
  } catch {
    fail("Unexpected project list response");
  }
  if (!Array.isArray(projects)) {
    fail("Unexpected project list response shape");
  }
  return projects;
}

// Hit the cwd-based project lookup. Returns `null` on miss or any error —
// callers fall through to the user-facing error path with full context.
// The shape is `{ project: Project | null }` (see
// `server/routes/projects.ts`), not the bare-array shape.
export async function resolveProjectByCwd(serverUrl, cwd) {
  if (!cwd) return null;
  const url = `${serverUrl.replace(/\/$/, "")}/api/projects?cwd=${encodeURIComponent(cwd)}`;
  let response;
  try {
    response = await fetch(url);
  } catch {
    return null;
  }
  if (response.status >= 400) return null;
  let body;
  try {
    body = await response.json();
  } catch {
    return null;
  }
  if (!body || typeof body !== "object") return null;
  return body.project ?? null;
}

// --- projects surface (issue #370) ---
//
// The third leg of the discovery tripod: `projects list` →
// `worktrees list <project>` → `sessions list <project> --worktree <id>`.
// Without it, an agent that knows a project by name had to shell out to
// `jq` against `<controller-home>/projects.json` to get the UUID the
// other two subcommands want.
//
// The source of truth here is `GET /api/projects` (via the existing
// `fetchProjectList`), not the registry file on disk: it's the same route
// `resolveProjectId` already uses to map a `<project>` name to an id, and
// it keeps this subcommand consistent with `worktrees list` /
// `sessions list`, which are both server-backed. No new server route is
// needed either way.

export function parseProjects(argv) {
  const [command, ...args] = argv;
  if (!command) fail(`Unknown projects command\n${USAGE}`);
  switch (command) {
    case "list": {
      // No filters in v1 (issue #370): the registry is short enough that
      // `--json` piped to `jq` covers every slice an agent needs. A stray
      // positional is almost always someone reaching for a filter that
      // doesn't exist yet, so reject it instead of silently ignoring it —
      // `assertKnownFlags` only sees `--`-prefixed tokens.
      const stray = args.find((arg) => !arg.startsWith("--"));
      if (stray !== undefined) {
        fail(
          `projects list takes no positional arguments (got "${stray}"). ` +
            `The list is unfiltered in v1 — pipe \`--json\` to \`jq\` to narrow it.`
        );
      }
      assertKnownFlags(args, ["--json"], "projects list");
      return { action: "list", body: { json: args.includes("--json") } };
    }
    default:
      fail(`Unknown projects command: ${command}\n${USAGE}`);
  }
}

// Project the server's payload down to the record persisted in
// `projects.json` (`ProjectRecord` in `server/lib/projects.ts`).
// `GET /api/projects` re-hydrates `setupCommands` / `runCommands` from
// the project's `*.sh` files on every read; those are script bodies
// rather than registry fields, so they stay out of the NDJSON — an agent
// piping this to `jq` wants ids and names, not a shell script. A
// `lastActiveAt` is passed through when the server knows one and omitted
// otherwise.
function toProjectRecord(project) {
  const record = {
    id: project.id,
    name: project.name,
    path: project.path,
    createdAt: project.createdAt,
  };
  if (typeof project.lastActiveAt === "string" && project.lastActiveAt) {
    record.lastActiveAt = project.lastActiveAt;
  }
  return record;
}

// One row per project, same single-line field shape as
// `formatSessionRow`: the id first (it's the handle the agent pastes
// into `worktrees list` / `sessions list`), then the human name, then
// the path on disk.
function formatProjectRow(project) {
  const name =
    typeof project.name === "string" && project.name.trim()
      ? project.name
      : "(unnamed)";
  const projectPath =
    typeof project.path === "string" && project.path ? project.path : "(no path)";
  const lastActive =
    typeof project.lastActiveAt === "string" && project.lastActiveAt
      ? `  lastActive=${project.lastActiveAt}`
      : "";
  return `${project.id ?? "?"}  ${name}  ${projectPath}${lastActive}`;
}

// Name-sorted, always (issue #370). Deliberately not `localeCompare`:
// its default collation varies with the host locale, and the order has
// to be identical on every machine for a scripted diff of two installs
// to be meaningful. Case-insensitive first (so `Zed` doesn't sort above
// `acme`), with the id as a tiebreaker for two projects sharing a name.
function compareProjects(a, b) {
  const aName = String(a.name ?? "").toLowerCase();
  const bName = String(b.name ?? "").toLowerCase();
  if (aName !== bName) return aName < bName ? -1 : 1;
  const aId = String(a.id ?? "");
  const bId = String(b.id ?? "");
  if (aId === bId) return 0;
  return aId < bId ? -1 : 1;
}

export async function runProjects(argv, serverUrl) {
  const parsed = parseProjects(argv);
  if (parsed.action === "list") {
    const projects = await fetchProjectList(serverUrl);
    const rows = projects
      .filter((project) => project && typeof project === "object")
      .sort(compareProjects);
    if (rows.length === 0) {
      // Same split as `sessions list`: `--json` emits nothing so the
      // output stays machine-readable (a literal `No projects match.`
      // would break `jq` / `wc -l` on a legitimately empty registry),
      // while the human view still gets the empty-state copy. Exit code
      // is 0 either way — an empty registry isn't an error.
      if (!parsed.body.json) {
        process.stdout.write("No projects match.\n");
      }
      return;
    }
    if (parsed.body.json) {
      for (const row of rows) {
        process.stdout.write(`${JSON.stringify(toProjectRecord(row))}\n`);
      }
      return;
    }
    for (const row of rows) {
      process.stdout.write(`${formatProjectRow(row)}\n`);
    }
    return;
  }
  fail(`Unknown projects action: ${parsed.action}`);
}

// --- worktrees surface (issue #190) ---

export function parseWorktrees(argv) {
  const [command, ...rest] = argv;
  if (!command) fail(`Unknown worktrees command\n${USAGE}`);
  // `<project>` is the optional first positional after the subcommand. If
  // the next token starts with `--` (or is missing), no project was given
  // and the CLI falls back to resolving by cwd via `resolveProjectId`.
  // This keeps `controller worktrees create --name foo` working — the
  // `--name` flag is the first argument, not the project.
  let project = "";
  let args = rest;
  if (rest[0] !== undefined && !rest[0].startsWith("--")) {
    project = rest[0];
    args = rest.slice(1);
  }
  switch (command) {
    case "list":
      return { project, action: "list" };
    case "create": {
      assertKnownFlags(args, ["--name", "--branch", "--base"], "worktrees create");
      const name = flagValue(args, "--name");
      if (!name) fail("worktrees create requires --name <name>");
      const branch = flagValue(args, "--branch");
      const base = flagValue(args, "--base");
      return {
        project,
        action: "create",
        body: {
          name,
          ...(branch ? { branch } : {}),
          ...(base ? { baseBranch: base } : {}),
        },
      };
    }
    case "delete": {
      if (!args[0]) fail("worktrees delete requires a <worktreeId>");
      return { project, action: "delete", worktreeId: args[0] };
    }
    default:
      fail(`Unknown worktrees command: ${command}\n${USAGE}`);
  }
}

function formatWorktreeRow(worktree) {
  const port = worktree.portOffset != null ? `  portOffset=${worktree.portOffset}` : "";
  const setup =
    worktree.setupExitCode != null
      ? `  setup=${worktree.setupExitCode === 0 ? "ok" : `exit(${worktree.setupExitCode})`}`
      : "";
  return `${worktree.id}  ${worktree.name}  ${worktree.branch ?? "(no branch)"}${worktree.isMain ? "  [main]" : ""}${port}${setup}\n  ${worktree.path}`;
}

export async function runWorktrees(argv, serverUrl) {
  const parsed = parseWorktrees(argv);
  const projectId = await resolveProjectId(serverUrl, parsed.project);
  if (parsed.action === "list") {
    const { response, result } = await getJson(
      serverUrl,
      `/api/projects/${projectId}/worktrees`
    );
    if (response.status >= 400) {
      fail(serverError(result, `Failed to list worktrees (HTTP ${response.status})`));
    }
    const worktrees = Array.isArray(result) ? result : [];
    if (worktrees.length === 0) {
      process.stdout.write("No worktrees.\n");
      return;
    }
    for (const worktree of worktrees) {
      process.stdout.write(`${formatWorktreeRow(worktree)}\n`);
    }
    return;
  }
  if (parsed.action === "create") {
    const url = `${serverUrl.replace(/\/$/, "")}/api/projects/${projectId}/worktrees`;
    let response;
    try {
      response = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...parsed.body, cwd: process.cwd() }),
      });
    } catch (error) {
      fail(`Could not reach the orchestrator: ${error?.message ?? error}`);
    }
    if (!response.body) {
      fail(`Worktree create failed (HTTP ${response.status})`);
    }
    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buffer = "";
    let exitCode = 0;
    let worktree = null;
    let errorText = null;
    for (;;) {
      const { value, done } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      let idx = buffer.indexOf("\n\n");
      while (idx !== -1) {
        const block = buffer.slice(0, idx);
        buffer = buffer.slice(idx + 2);
        const dataLine = block.split("\n").find((line) => line.startsWith("data: "));
        if (dataLine) {
          let event;
          try {
            event = JSON.parse(dataLine.slice(6));
          } catch {
            continue;
          }
          if (event.type === "log" && typeof event.text === "string") {
            process.stdout.write(event.text.endsWith("\n") ? event.text : `${event.text}\n`);
          } else if (event.type === "worktree_created" && event.worktree) {
            worktree = event.worktree;
          } else if (event.type === "error" && typeof event.text === "string") {
            errorText = event.text;
            process.stderr.write(`${event.text}\n`);
          } else if (event.type === "done") {
            exitCode = typeof event.exitCode === "number" ? event.exitCode : 0;
            if (event.worktree) worktree = event.worktree;
          }
        }
        idx = buffer.indexOf("\n\n");
      }
    }
    if (exitCode !== 0) {
      fail(errorText ?? `Worktree create failed (exit ${exitCode})`);
    }
    if (!worktree) {
      fail("Worktree create stream ended without a worktree payload");
    }
    process.stdout.write(`\nCreated worktree ${worktree.name} (id=${worktree.id})\n  ${worktree.path}\n`);
    return;
  }
  if (parsed.action === "delete") {
    const { response, result } = await deleteJson(
      serverUrl,
      `/api/projects/${projectId}/worktrees/${parsed.worktreeId}`
    );
    if (response.status >= 400) {
      fail(serverError(result, `Failed to delete worktree (HTTP ${response.status})`));
    }
    process.stdout.write("Deleted worktree.\n");
    return;
  }
  fail(`Unknown worktrees action: ${parsed.action}`);
}

async function getJson(serverUrl, route) {
  let response;
  try {
    response = await fetch(`${serverUrl.replace(/\/$/, "")}${route}`);
  } catch (error) {
    fail(`Could not reach the orchestrator: ${error?.message ?? error}`);
  }
  let result;
  try {
    result = await response.json();
  } catch {
    result = null;
  }
  return { response, result };
}

// --- sessions surface (issue #190) ---

export function parseSessions(argv) {
  const [command, ...rest] = argv;
  if (!command) fail(`Unknown sessions command\n${USAGE}`);
  // `<project>` is the optional first positional on `start` and `list`
  // (issue #190, #353). On `start` we have to disambiguate it from
  // the message positional (issue #355): both can be bare tokens at
  // the front of argv. Counting the leading non-`--…` tokens gives us
  // three shapes:
  //   - 0 leading bare tokens  → no `<project>`, no message yet; the
  //     helper below resolves the message from `args`. (e.g.
  //     `start --worktree wt-1 "Fix"`)
  //   - 1 leading bare token   → that's the message on `start`, but
  //     the project on `list` (where there's no second positional to
  //     confuse it with). `<project>` falls back to cwd via
  //     `resolveProjectId`.
  //   - 2 leading bare tokens  → on `start`, first is `<project>` and
  //     second is the message; on `list`, the first is `<project>` and
  //     the second is a stray (which `list`'s `assertKnownFlags`
  //     rejects).
  //   - ≥3 leading bare tokens → too many positionals; the helper
  //     surfaces this as a "Unexpected positional after the message".
  // The previous "first bare token is always `<project>`" rule ate the
  // message-first shape on `start` and made
  // `start "Fix" --worktree wt-1` fail, so the coordinator command in
  // `agent-preamble.ts` regressed.
  let project = "";
  let args = rest;
  if (command === "start") {
    const leadingBare = countLeadingBareTokens(rest);
    if (leadingBare >= 2) {
      project = rest[0];
      args = rest.slice(1);
    }
  } else if (command === "list") {
    // `list` always treats the first bare token as `<project>` — there
    // is no message positional to compete with. A stray second bare
    // token before any flag is rejected by `assertKnownFlags` below.
    if (rest[0] !== undefined && !rest[0].startsWith("--")) {
      project = rest[0];
      args = rest.slice(1);
    }
  }
  // `wake` doesn't take a `<project>` positional because the server's
  // per-session routes resolve the owning project from the session
  // file (issue #339). Its first bare token is always the message
  // (or a session id, in `wake`'s case).
  switch (command) {
    case "start": {
      // Issue #355: the message is a positional argument (the second
      // positional, after the optional `<project>`), not a `--message`
      // flag. The positional is the only "free" non-`--…` token in
      // `args` — every other non-`--…` token is consumed as the value
      // of the preceding known flag. So `start "Fix" --worktree wt-1`
      // (positional first, then flag pair) and `start --worktree wt-1
      // "Fix"` (flag pair first, then positional) both parse cleanly.
      //
      // The previous `--message` flag and last-flag guard are gone —
      // the message no longer competes with flags for the same
      // trailing position, and prompts like `"explain the --json
      // flag"` work without escaping the leading `--`.
      const messageResult = extractMessageAndFlagArgs(
        args,
        [
          "--worktree",
          "--provider",
          "--agent",
          "--model",
          "--mode",
          "--skill",
          "--parent",
        ],
        "sessions start"
      );
      const { message, flagArgs } = messageResult;
      const worktreeId = flagValue(flagArgs, "--worktree");
      if (!worktreeId) fail("sessions start requires --worktree <worktreeId>");
      // `--agent` is a forgiving alias for `--provider` (issue #306). The
      // canonical name stays `--provider` in docs and skill examples; this
      // alias just keeps a natural typo from silently swapping the agent
      // to the default provider.
      const providerFromFlag = flagValue(flagArgs, "--provider");
      const providerFromAlias = flagValue(flagArgs, "--agent");
      let provider = undefined;
      if (providerFromFlag != null && providerFromAlias != null) {
        if (providerFromFlag !== providerFromAlias) {
          fail(
            `sessions start: --provider (${providerFromFlag}) and --agent (${providerFromAlias}) disagree. ` +
              `Pass only one of them.`
          );
        }
        provider = providerFromFlag;
      } else {
        provider = providerFromFlag ?? providerFromAlias;
      }
      const model = flagValue(flagArgs, "--model");
      const mode = flagValue(flagArgs, "--mode");
      const skill = flagValue(flagArgs, "--skill");
      // `--parent` records the new session as a child of the given
      // parent (issue #353). The literal value `self` resolves to the
      // calling session's id via `$CONTROLLER_SESSION_ID` — the
      // orchestrator injects that env var when spawning an agent, so
      // the agent can spawn a child without first looking up its own
      // id. When `self` is used and the env var is missing (e.g. the
      // agent was spawned outside the orchestrator, or it's a brand-
      // new session whose id isn't assigned yet), the CLI surfaces a
      // clear error pointing at the env var so the agent can use
      // `controller sessions list` to discover its id.
      const parentFlag = flagValue(flagArgs, "--parent");
      const parentId = resolveParentFlag(parentFlag);
      return {
        project,
        action: "start",
        body: {
          worktreeId,
          message,
          ...(provider ? { provider } : {}),
          ...(model ? { model } : {}),
          ...(mode ? { mode } : {}),
          ...(skill ? { skillName: skill } : {}),
          ...(parentId ? { parentId } : {}),
        },
      };
    }
    case "list": {
      // `sessions list [<project>] [--worktree <id>] [--parent <id|self>]
      //  [--provider <id>] [--json] [--limit <n>]` (issue #353).
      //
      // Mirrors the positional shape of `worktrees list` / `sessions
      // start` / `schedules list`: <project> is the optional first
      // positional and falls back to the project that owns cwd.
      assertKnownFlags(
        args,
        [
          "--worktree",
          "--parent",
          "--provider",
          "--json",
          "--limit",
        ],
        "sessions list"
      );
      const worktreeId = flagValue(args, "--worktree");
      // `--parent` reuses the same `self` resolution as `start` — the
      // env var is set by the orchestrator when it spawns the calling
      // agent, so an agent running `sessions list --parent self` can
      // see its own children without first looking up its id.
      const parentFlag = flagValue(args, "--parent");
      const parentId = resolveParentFlag(parentFlag);
      const provider = flagValue(args, "--provider");
      const json = args.includes("--json");
      const limitRaw = flagValue(args, "--limit");
      let limit;
      if (limitRaw != null) {
        const parsed = Number(limitRaw);
        if (!Number.isInteger(parsed) || parsed <= 0) {
          fail("sessions list: --limit must be a positive integer");
        }
        limit = parsed;
      }
      return {
        project,
        action: "list",
        body: {
          ...(worktreeId ? { worktreeId } : {}),
          ...(parentId ? { parentId } : {}),
          ...(provider ? { provider } : {}),
          ...(json ? { json: true } : {}),
          ...(limit != null ? { limit } : {}),
        },
      };
    }
    case "wake": {
      // `sessions wake <sessionId> --message <text> [--delay 30s] ...`
      // <project> is intentionally NOT a positional here: the server's
      // `/api/sessions/:sessionId/wake` route resolves the owning project
      // from the session file on disk. The agent's natural usage is
      // `wake <self>` (issue #339), and requiring a project would force
      // every call to thread a project id that the orchestrator already
      // has. We re-do the positional parsing here rather than reusing the
      // outer `<project>` strip above because the wake surface has a
      // different positional shape.
      const sessionId = rest[0];
      if (!sessionId || sessionId.startsWith("--")) {
        fail("sessions wake requires a sessionId");
      }
      // Issue #355: the message is a positional argument (the second
      // positional, after the session id), not a `--message` flag. It
      // can come before or after the wake-specific flags (`--delay`,
      // `--run-at`, ...); the previous last-flag guard is gone.
      const wakeArgs = rest.slice(1);
      const { message, flagArgs } = extractMessageAndFlagArgs(
        wakeArgs,
        [
          "--delay",
          "--run-at",
          "--provider",
          "--agent",
          "--model",
          "--mode",
          "--skill",
        ],
        "sessions wake"
      );
      const delay = flagValue(flagArgs, "--delay");
      const runAt = flagValue(flagArgs, "--run-at");
      if (delay && runAt) {
        fail("sessions wake: --delay and --run-at are mutually exclusive; pick one.");
      }
      const providerFromFlag = flagValue(flagArgs, "--provider");
      const providerFromAlias = flagValue(flagArgs, "--agent");
      let provider = undefined;
      if (providerFromFlag != null && providerFromAlias != null) {
        if (providerFromFlag !== providerFromAlias) {
          fail(
            `sessions wake: --provider (${providerFromFlag}) and --agent (${providerFromAlias}) disagree. ` +
              `Pass only one of them.`
          );
        }
        provider = providerFromFlag;
      } else {
        provider = providerFromFlag ?? providerFromAlias;
      }
      const model = flagValue(flagArgs, "--model");
      const mode = flagValue(flagArgs, "--mode");
      const skill = flagValue(flagArgs, "--skill");
      // `--delay` is the documented default; `--run-at` exists for the UI
      // (date picker) and for tests. The server resolves either into an
      // ISO timestamp before persisting — sending the raw form keeps
      // the wire format independent of clock skew.
      return {
        project: "",
        action: "wake",
        sessionId,
        body: {
          // The wake route accepts `message` (the prompt text). We keep
          // `text` / `visibleText` out of the wire shape so the server
          // doesn't have to alias them — the agent sees a clean POST.
          message,
          provider: provider ?? "",
          model: model ?? "",
          mode: mode === "plan" ? "plan" : "default",
          attachmentIds: [],
          ...(skill ? { skillName: skill } : {}),
          ...(delay ? { delay } : {}),
          ...(runAt ? { runAtIso: runAt } : {}),
        },
      };
    }
    case "send": {
      // `sessions send <targetSessionId> <message> --from <parentId|self>`
      // (issue #351).
      //
      // The route accepts a positional message and a `--from` flag
      // naming the parent (issue #351 coordinator primitive). When
      // `--from self` is used, the CLI resolves the literal `self`
      // to the calling session's id via `$CONTROLLER_SESSION_ID` —
      // an agent that doesn't know its own id can still send with
      // `controller sessions send <target> "..." --from self`.
      //
      // Same positional-message + `--` end-of-flags shape as
      // `sessions start` / `wake` (issue #355).
      const targetFlag = rest[0];
      if (!targetFlag || targetFlag.startsWith("--")) {
        fail("sessions send requires a <targetSessionId>");
      }
      const targetSessionId = resolveParentFlag(targetFlag);
      if (!targetSessionId) {
        fail(
          `sessions send: target 'self' requires $CONTROLLER_SESSION_ID; ` +
            `the agent that ran this command was not spawned by the orchestrator. ` +
            `Run \`controller sessions list\` to discover your id and pass it explicitly.`
        );
      }
      const sendArgs = rest.slice(1);
      const { message, flagArgs } = extractMessageAndFlagArgs(
        sendArgs,
        ["--from"],
        "sessions send"
      );
      const fromFlag = flagValue(flagArgs, "--from");
      if (!fromFlag) {
        fail("sessions send requires --from <parentSessionId|self>");
      }
      const fromSessionId = resolveParentFlag(fromFlag);
      if (!fromSessionId) {
        fail(
          `sessions send: --from self requires $CONTROLLER_SESSION_ID; ` +
            `the agent that ran this command was not spawned by the orchestrator. ` +
            `Run \`controller sessions list\` to discover your id and pass it explicitly.`
        );
      }
      return {
        project: "",
        action: "send",
        targetSessionId,
        fromSessionId,
        body: { message },
      };
    }
    case "children": {
      // `sessions children <parentSessionId>` (issue #351). No
      // project qualifier — the route walks every project × worktree
      // pair (the same cross-worktree walk `listChildSessions`
      // already does on the server) so a parent on the main worktree
      // and a child on a feature worktree are both returned.
      //
      // `<parentSessionId>` accepts the same `self` shortcut as
      // `--parent` on `start` / `list` — the agent can discover its
      // own children without first looking up its id.
      const parentFlag = rest[0];
      if (!parentFlag || parentFlag.startsWith("--")) {
        fail("sessions children requires a <parentSessionId|self>");
      }
      const parentId = resolveParentFlag(parentFlag);
      if (!parentId) {
        fail(
          `sessions children: 'self' requires $CONTROLLER_SESSION_ID; ` +
            `the agent that ran this command was not spawned by the orchestrator. ` +
            `Run \`controller sessions list\` to discover your id and pass it explicitly.`
        );
      }
      return {
        project: "",
        action: "children",
        parentId,
      };
    }
    case "branch": {
      // `sessions branch <sourceSessionId|self> <message> [flags]`
      // (issue #364).
      //
      // The verb forks an existing session into a brand-new one whose
      // transcript is a copy of the source's transcript up to (and
      // including) the user's first new message. The first turn of
      // the new branch can run on a different `--provider` /
      // `--model` / `--mode` than the source; later turns use the
      // source's defaults (the model picker in the composer falls
      // back to whatever the source had).
      //
      // Wire shape mirrors `sessions start` (issue #355 positional
      // message + `--` end-of-flags), but the first positional is the
      // *source session id* — the worktree id is implied (the source
      // lives on a specific worktree, and the branch inherits that
      // worktree; cross-worktree branches are out of scope per the
      // issue). `--from <id|self>` is an alias for the positional
      // source so the call shape reads naturally in scripts; the
      // positional wins when both are present.
      //
      // We strip the source + any `--from` pair before handing the
      // remaining args to `extractMessageAndFlagArgs`, which gives
      // us the same positional-message + flag-pair walker as
      // `start` / `wake` / `send`.
      const positionalSource = rest[0] && !rest[0].startsWith("--") ? rest[0] : undefined;
      const fromIdx = rest.indexOf("--from");
      const aliasSource = fromIdx >= 0 ? rest[fromIdx + 1] : undefined;
      // Positional wins when both are present (the issue's
      // recommendation). Error if neither is set.
      const sourceRaw = positionalSource ?? aliasSource;
      if (!sourceRaw || sourceRaw.startsWith("--")) {
        fail("sessions branch requires a <sourceSessionId|self> (or --from <id|self>)");
      }
      if (positionalSource && aliasSource && positionalSource !== aliasSource) {
        fail(
          `sessions branch: positional source (${positionalSource}) and --from (${aliasSource}) disagree. ` +
            `Pass only one of them.`
        );
      }
      const sourceSessionId = resolveParentFlag(sourceRaw);
      if (!sourceSessionId) {
        fail(
          `sessions branch: source 'self' requires $CONTROLLER_SESSION_ID; ` +
            `the agent that ran this command was not spawned by the orchestrator. ` +
            `Run \`controller sessions list\` to discover your id and pass it explicitly.`
        );
      }
      // Build the args slice the positional parser sees. We strip
      // the positional source id and any `--from <value>` pair so
      // the message positional + the flag pairs are the only things
      // left. The filter walks `rest` once and drops:
      //   - rest[0] if it's the positional source
      //   - the `--from` flag and its value (when `--from <value>`
      //     is the alias form — `--from` always takes a value, so
      //     we can increment i past it safely)
      const branchArgs = [];
      for (let i = 0; i < rest.length; i += 1) {
        const arg = rest[i];
        if (i === 0 && arg === positionalSource) continue;
        if (arg === "--from") {
          // Skip the flag and its value.
          i += 1;
          continue;
        }
        branchArgs.push(arg);
      }
      const { message, flagArgs } = extractMessageAndFlagArgs(
        branchArgs,
        [
          "--provider",
          "--agent",
          "--model",
          "--mode",
          "--title",
        ],
        "sessions branch"
      );
      const providerFromFlag = flagValue(flagArgs, "--provider");
      const providerFromAlias = flagValue(flagArgs, "--agent");
      let provider = undefined;
      if (providerFromFlag != null && providerFromAlias != null) {
        if (providerFromFlag !== providerFromAlias) {
          fail(
            `sessions branch: --provider (${providerFromFlag}) and --agent (${providerFromAlias}) disagree. ` +
              `Pass only one of them.`
          );
        }
        provider = providerFromFlag;
      } else {
        provider = providerFromFlag ?? providerFromAlias;
      }
      const model = flagValue(flagArgs, "--model");
      const mode = flagValue(flagArgs, "--mode");
      const title = flagValue(flagArgs, "--title");
      return {
        project: "",
        action: "branch",
        sourceSessionId,
        body: {
          // `sourceSessionId` lives in `body` for symmetry with the
          // wire format the server expects (`POST /sessions/branch`
          // reads `sourceSessionId` from the JSON body). The CLI
          // dispatcher reads it from `parsed.sourceSessionId`
          // directly so the call stays typed; carrying it in
          // `body` too keeps the parser output aligned with the
          // server wire shape, which is what the issue's test
          // cases assert.
          sourceSessionId,
          message,
          // Empty strings are dropped server-side; the server falls
          // back to the source's provider/model/mode when these are
          // absent (issue #364 design §2).
          ...(provider ? { provider } : {}),
          ...(model ? { model } : {}),
          ...(mode ? { mode } : {}),
          ...(title ? { title } : {}),
        },
      };
    }
    case "monitor": {
      // `sessions monitor <start|list|stop> ...` (issue #339). The
      // surface is parsed by a dedicated `parseMonitor` (the same
      // shape as `goal` — a sub-shape that takes its own positional
      // args), and dispatched by `runMonitor`. The route is mounted
      // under `/api/sessions/:sessionId/monitors` so the agent
      // doesn't need a project id — the same per-session walker the
      // wake + goal surfaces use.
      return {
        project: "",
        action: "monitor",
        monitorArgv: rest,
      };
    }
    default:
      fail(`Unknown sessions command: ${command}\n${USAGE}`);
  }
}

// --- sessions goal surface (issue #339) ---

/*
 * `sessions goal <set|clear|show> <sessionId> ...` — same shape as
 * `wake`: <project> is optional and resolved by the server from the
 * session file (issue #339). The three subcommands map to three HTTP
 * verbs on the per-session goal endpoint:
 *   - set   → PUT  { action: "set",   condition, maxTurns?, expiresAt? }
 *   - clear → PUT  { action: "clear" }
 *   - show  → GET
 *
 * The positional parsing re-reads from `rest` (not `args`) because the
 * outer `<project>` strip above eats the first non-flag token — if
 * `<project>` is supplied, the session id would land at `args[0]`, but
 * when it's omitted the session id IS `rest[0]`. Reading from `rest`
 * works for both shapes; the unused `project` value is preserved for
 * the route layer's resolver.
 */
export function parseGoal(argv) {
  const [command, ...rest] = argv;
  if (!command) fail("sessions goal requires a subcommand: set, clear, show");
  // `<project>` is the optional first positional. Match `sessions wake`:
  // if the next token starts with `--`, the user didn't supply a
  // project and the run path falls back to cwd via `resolveProjectId`.
  let project = "";
  let args = rest;
  if (rest[0] !== undefined && !rest[0].startsWith("--")) {
    project = rest[0];
    args = rest.slice(1);
  }
  switch (command) {
    case "set": {
      const sessionId = rest[0];
      if (!sessionId || sessionId.startsWith("--")) {
        fail("sessions goal set requires a sessionId");
      }
      const goalArgs = rest.slice(1);
      assertKnownFlags(
        goalArgs,
        ["--condition", "--max-turns", "--expires-at"],
        "sessions goal set"
      );
      const condition = flagValue(goalArgs, "--condition");
      if (!condition || !condition.trim()) {
        fail("sessions goal set requires --condition <text>");
      }
      const maxTurnsRaw = flagValue(goalArgs, "--max-turns");
      let maxTurns;
      if (maxTurnsRaw != null) {
        const parsed = Number(maxTurnsRaw);
        if (!Number.isInteger(parsed) || parsed <= 0) {
          fail("sessions goal set: --max-turns must be a positive integer");
        }
        maxTurns = parsed;
      }
      const expiresAt = flagValue(goalArgs, "--expires-at");
      return {
        project,
        action: "set",
        sessionId,
        body: {
          action: "set",
          condition,
          ...(maxTurns != null ? { maxTurns } : {}),
          ...(expiresAt ? { expiresAt } : {}),
        },
      };
    }
    case "clear": {
      const sessionId = rest[0];
      if (!sessionId || sessionId.startsWith("--")) {
        fail("sessions goal clear requires a sessionId");
      }
      return {
        project,
        action: "clear",
        sessionId,
        body: { action: "clear" },
      };
    }
    case "show": {
      const sessionId = rest[0];
      if (!sessionId || sessionId.startsWith("--")) {
        fail("sessions goal show requires a sessionId");
      }
      return { project, action: "show", sessionId };
    }
    default:
      fail(`Unknown sessions goal command: ${command}\n${USAGE}`);
  }
}

export async function runSessions(argv, serverUrl) {
  const parsed = parseSessions(argv);
  const projectId = await resolveProjectId(serverUrl, parsed.project);
  if (parsed.action === "start") {
    const { response, result } = await postJson(
      serverUrl,
      `/api/projects/${projectId}/sessions`,
      parsed.body
    );
    if (response.status >= 400) {
      fail(serverError(result, `Failed to start session (HTTP ${response.status})`));
    }
    const sessionId = result?.sessionId;
    const url = result?.url;
    if (typeof sessionId !== "string" || !sessionId) {
      fail("Server did not return a sessionId");
    }
    process.stdout.write(`Started session ${sessionId}\n`);
    if (typeof url === "string" && url) {
      process.stdout.write(`Open in Controller: ${url}\n`);
    }
    return;
  }
  if (parsed.action === "wake") {
    // The wake route is mounted under `/api/sessions/:sessionId/wake` so
    // the agent's natural `wake <self>` usage doesn't need a project id
    // (the server resolves it from the session file). Issue #339.
    const route = `/api/sessions/${parsed.sessionId}/wake`;
    const { response, result } = await postJson(serverUrl, route, parsed.body);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to wake session (HTTP ${response.status})`));
    }
    const message = result?.message;
    const queuedId = message?.id;
    const runAt = message?.runAt;
    if (typeof queuedId !== "string" || !queuedId) {
      fail("Server did not return a queued message id");
    }
    process.stdout.write(`Enqueued wake ${queuedId}`);
    if (typeof runAt === "string" && runAt) {
      process.stdout.write(` (runs at ${runAt})`);
    }
    process.stdout.write(`\n`);
    return;
  }
  if (parsed.action === "send") {
    // Cross-session send (issue #351). Posts to a per-session route
    // that walks every project × worktree pair to resolve the
    // target (the same `locateSessionById` walk the wake + goal +
    // monitor surfaces use). The server records a `user_message`
    // event on the target whose text is the canonical
    // `[/from: <parentTitle>] <message>` marker so the agent can
    // round-trip the message through its own transcript and the
    // linkifier can render the parent title as a `controller://`
    // deep link.
    const route = `/api/sessions/${parsed.targetSessionId}/send-from`;
    const body = { ...parsed.body, fromSessionId: parsed.fromSessionId };
    const { response, result } = await postJson(serverUrl, route, body);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to send (HTTP ${response.status})`));
    }
    const queuedId = result?.eventId;
    if (typeof queuedId !== "string" || !queuedId) {
      fail("Server did not return an event id");
    }
    process.stdout.write(`Enqueued send ${queuedId} on ${parsed.targetSessionId}\n`);
    return;
  }
  if (parsed.action === "children") {
    // Cross-worktree children enumeration (issue #351). The route
    // walks every project × worktree pair so a parent on the main
    // worktree and a child on a feature worktree are both found.
    const route = `/api/sessions/${parsed.parentId}/children`;
    const { response, result } = await getJson(serverUrl, route);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to list children (HTTP ${response.status})`));
    }
    const children = Array.isArray(result?.children) ? result.children : [];
    if (children.length === 0) {
      process.stdout.write("No children.\n");
      return;
    }
    for (const child of children) {
      process.stdout.write(`${formatChildRow(child)}\n`);
    }
    return;
  }
  if (parsed.action === "list") {
    await runSessionsList(parsed.body, serverUrl, projectId);
    return;
  }
  if (parsed.action === "branch") {
    // Fork an existing session into a brand-new one (issue #364).
    // The route is mounted under `/api/projects/:projectId/sessions/branch`
    // and the server resolves the source via the cross-worktree
    // `locateSessionById` walk. The CLI parser already threads
    // `sourceSessionId` through `parsed.body` (matching the server
    // wire shape) and resolves `--from` / `self` aliases; we just
    // forward the body. The response shape matches the headless
    // `start` endpoint (`{ sessionId, url }`), so the CLI prints
    // the same "Started session … / Open in Controller: …" lines.
    const route = `/api/projects/${projectId}/sessions/branch`;
    const { response, result } = await postJson(serverUrl, route, parsed.body);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to branch session (HTTP ${response.status})`));
    }
    const sessionId = result?.sessionId;
    const url = result?.url;
    if (typeof sessionId !== "string" || !sessionId) {
      fail("Server did not return a sessionId");
    }
    process.stdout.write(`Branched session ${sessionId} from ${parsed.sourceSessionId}\n`);
    if (typeof url === "string" && url) {
      process.stdout.write(`Open in Controller: ${url}\n`);
    }
    return;
  }
  if (parsed.action === "monitor") {
    // Delegate to the dedicated `runMonitor` dispatcher (issue #339).
    // The parse pass is re-done inside `runMonitor` because the
    // monitor sub-shape (`start | list | stop`) takes its own
    // positional args; `parseSessions` only knows the surface
    // exists. The `projectId` is unused — the per-session monitor
    // route resolves its own session.
    await runMonitor(parsed.monitorArgv, serverUrl);
    return;
  }
  fail(`Unknown sessions action: ${parsed.action}`);
}

/*
 * `sessions list` dispatcher (issue #353). Loads the session summaries
 * from the server, applies the client-side filters, and prints either a
 * human-readable table or NDJSON.
 *
 * The server already exposes `GET /api/projects/:id/sessions?worktreeId=…`
 * which returns a summaries array (no transcript, just the metadata the
 * sidebar needs). For `--worktree` we hit that endpoint directly. For
 * `--parent`, however, a parent on the main worktree and a child on a
 * feature worktree live in different per-worktree stores — the server
 * route is worktree-scoped, so the CLI walks every worktree of the
 * project and filters client-side. The same fix as #351's
 * `listChildSessions`, expressed at the CLI layer where every project ×
 * worktree pair is already addressable.
 */
async function runSessionsList(filters, serverUrl, projectId) {
  const { worktreeId, parentId, provider, json, limit } = filters;
  const effectiveLimit = typeof limit === "number" && limit > 0 ? limit : 100;
  const summaries = await fetchSessionSummaries(
    serverUrl,
    projectId,
    worktreeId
  );
  let rows = Array.isArray(summaries) ? summaries.slice() : [];
  // Apply the client-side filters. Each filter is a no-op when its
  // argument is absent; combining them is the whole point of doing
  // this in the CLI rather than the server.
  if (parentId) {
    rows = rows.filter(
      (row) => row && typeof row === "object" && row.parentId === parentId
    );
  }
  if (provider) {
    rows = rows.filter(
      (row) => row && typeof row === "object" && row.provider === provider
    );
  }
  // Sort by `lastActiveAt` descending to match the server's natural
  // order; the per-worktree walk may have interleaved rows from
  // different worktrees otherwise.
  rows.sort(
    (a, b) =>
      new Date(b?.lastActiveAt ?? 0).getTime() -
      new Date(a?.lastActiveAt ?? 0).getTime()
  );
  if (rows.length > effectiveLimit) {
    rows = rows.slice(0, effectiveLimit);
  }
  if (rows.length === 0) {
    // Empty filter result: in `--json` mode emit nothing so the output
    // stays machine-readable for pipelines (a literal `No sessions
    // match.` text would break `jq`, `wc -l`, etc. on a legitimate
    // zero-result query — issue #353 review). The exit code is still
    // 0 so consumers can treat the absence of rows as "no matches"
    // rather than as an error. In human-readable mode the empty-state
    // copy is still printed.
    if (!json) {
      process.stdout.write("No sessions match.\n");
    }
    return;
  }
  if (json) {
    for (const row of rows) {
      process.stdout.write(`${JSON.stringify(row)}\n`);
    }
    return;
  }
  for (const row of rows) {
    process.stdout.write(`${formatSessionRow(row)}\n`);
  }
}

/**
 * Fetch session summaries from the server. When `worktreeId` is given
 * we hit the per-worktree endpoint directly. When the caller needs to
 * walk every worktree (e.g. `--parent <id>`), the server route is
 * worktree-scoped so we enumerate the project's worktrees first and
 * merge the results.
 */
async function fetchSessionSummaries(serverUrl, projectId, worktreeId) {
  // `--worktree` short-circuits the per-worktree walk: the user has
  // already named the worktree, so hit the existing per-worktree
  // endpoint and apply the other filters on top.
  if (worktreeId) {
    const { response, result } = await getJson(
      serverUrl,
      `/api/projects/${projectId}/sessions?worktreeId=${encodeURIComponent(worktreeId)}`
    );
    if (response.status >= 400) {
      fail(
        serverError(result, `Failed to list sessions (HTTP ${response.status})`)
      );
    }
    return Array.isArray(result) ? result : [];
  }
  // No `--worktree`: walk every worktree so `--parent` (which has no
  // worktree-scoped server route yet) can find children that live on
  // a different worktree than the parent. Main worktree first because
  // most projects have one and the per-worktree filter above would
  // have caught the common case.
  const { response, result } = await getJson(
    serverUrl,
    `/api/projects/${projectId}/worktrees`
  );
  if (response.status >= 400) {
    fail(
      serverError(result, `Failed to list worktrees (HTTP ${response.status})`)
    );
  }
  const worktrees = Array.isArray(result) ? result : [];
  if (worktrees.length === 0) {
    return [];
  }
  const all = [];
  for (const worktree of worktrees) {
    if (!worktree || typeof worktree.id !== "string") continue;
    const { response: listResponse, result: listResult } = await getJson(
      serverUrl,
      `/api/projects/${projectId}/sessions?worktreeId=${encodeURIComponent(worktree.id)}`
    );
    if (listResponse.status >= 400) continue;
    if (Array.isArray(listResult)) {
      all.push(...listResult);
    }
  }
  return all;
}

/** Human-readable row for a session summary (issue #353). */
function formatSessionRow(row) {
  const provider = row.provider ? `[${row.provider}]` : "[?]";
  const title =
    typeof row.title === "string" && row.title.trim()
      ? row.title
      : "(untitled)";
  const lastActive =
    typeof row.lastActiveAt === "string" ? row.lastActiveAt : "";
  const worktree = row.worktreeId ? `  wt=${row.worktreeId}` : "";
  const parent = row.parentId ? `  parent=${row.parentId}` : "";
  return `${row.id}  ${provider}  ${title}${worktree}${parent}  lastActive=${lastActive}`;
}

/**
 * Format one child row for the `sessions children` output (issue #351).
 * Mirrors the focus-queue row style so the terminal output stays
 * legible at a glance. The id is the canonical handle (the agent can
 * paste it into a `wake` / `send` invocation), the title is whatever
 * the user renamed the child to (or a placeholder when none has been
 * set yet), and `agent=` is the provider so the agent can tell at a
 * glance whether the child is its own kind or a sibling.
 */
function formatChildRow(child) {
  const id = typeof child?.id === "string" ? child.id : "?";
  const title =
    typeof child?.title === "string" && child.title.trim()
      ? child.title
      : "(untitled)";
  const provider =
    typeof child?.provider === "string" && child.provider
      ? child.provider
      : "unknown";
  const status = typeof child?.status === "string" ? child.status : "?";
  return `${id}  [${provider}]  ${title}  status=${status}`;
}

export async function runGoal(argv, serverUrl) {
  const parsed = parseGoal(argv);
  if (parsed.action === "show") {
    const route = `/api/sessions/${parsed.sessionId}/goal`;
    const { response, result } = await getJson(serverUrl, route);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to load goal (HTTP ${response.status})`));
    }
    const goal = result?.goal;
    if (!goal) {
      process.stdout.write("No goal attached.\n");
      return;
    }
    process.stdout.write(
      [
        `session=${goal.sessionId}`,
        `condition="${goal.condition}"`,
        goal.maxTurns != null ? `maxTurns=${goal.maxTurns}` : null,
        goal.expiresAt ? `expiresAt=${goal.expiresAt}` : null,
        `turnsEvaluated=${goal.turnsEvaluated}`,
        goal.lastReason ? `lastReason="${goal.lastReason}"` : null,
      ]
        .filter(Boolean)
        .join("\n  ") + "\n"
    );
    return;
  }
  // set / clear share the same PUT endpoint; the body's `action` field
  // distinguishes them on the server side.
  const route = `/api/sessions/${parsed.sessionId}/goal`;
  const { response, result } = await putJson(serverUrl, route, parsed.body);
  if (response.status >= 400) {
    fail(
      serverError(result, `Failed to ${parsed.action} goal (HTTP ${response.status})`)
    );
  }
  if (parsed.action === "clear") {
    process.stdout.write("Goal cleared.\n");
    return;
  }
  const goal = result?.goal;
  process.stdout.write(
    `Goal set (id=${goal?.sessionId ?? parsed.sessionId})\n` +
      `  condition="${goal?.condition ?? ""}"\n`
  );
}

// --- sessions monitor surface (issue #339) ---

/*
 * `sessions monitor <start|list|stop> ...`. Mirrors `goal`: the
 * server-side `monitorBySessionIdRouter` resolves the owning project,
 * so the agent invokes by session id only. \`start\` spawns the
 * child; \`list\` returns active monitors; \`stop\` kills a monitor
 * by its UUID.
 */
export function parseMonitor(argv) {
  const [command, ...rest] = argv;
  if (!command) {
    fail("sessions monitor requires a subcommand: start, list, stop");
  }
  switch (command) {
    case "start": {
      const sessionId = rest[0];
      if (!sessionId || sessionId.startsWith("--")) {
        fail("sessions monitor start requires a sessionId");
      }
      const monitorArgs = rest.slice(1);
      assertKnownFlags(
        monitorArgs,
        [
          "--description",
          "--command",
          "--timeout-ms",
          "--persistent",
          "--on-line",
        ],
        "sessions monitor start"
      );
      const description = flagValue(monitorArgs, "--description");
      if (!description || !description.trim()) {
        fail("sessions monitor start requires --description <text>");
      }
      const command = flagValue(monitorArgs, "--command");
      if (!command || !command.trim()) {
        fail("sessions monitor start requires --command <shell>");
      }
      const timeoutMsRaw = flagValue(monitorArgs, "--timeout-ms");
      let timeoutMs;
      if (timeoutMsRaw != null) {
        const parsed = Number(timeoutMsRaw);
        if (!Number.isFinite(parsed) || parsed <= 0) {
          fail("sessions monitor start: --timeout-ms must be a positive number");
        }
        timeoutMs = parsed;
      }
      const persistent = monitorArgs.includes("--persistent");
      // Issue #351: optional `--on-line <regex>` filter. When set,
      // every stdout line that matches is re-injected as a
      // `user_message` event whose text is
      // `[/monitor: <description>] <line>` — same marker shape as
      // `sessions send`'s `[/from: …]`. The server compiles the
      // pattern; the CLI just passes the raw string through. A
      // blank value is rejected so the agent can't accidentally
      // turn the monitor into a "match every line" echo (which
      // would flood the event log).
      const onLine = flagValue(monitorArgs, "--on-line");
      if (onLine != null && !onLine.trim()) {
        fail("sessions monitor start: --on-line must be a non-empty regex");
      }
      return {
        action: "start",
        sessionId,
        body: {
          description,
          command,
          ...(timeoutMs != null ? { timeoutMs } : {}),
          ...(persistent ? { persistent: true } : {}),
          ...(onLine && onLine.trim() ? { onLine: onLine.trim() } : {}),
        },
      };
    }
    case "list": {
      const sessionId = rest[0];
      if (!sessionId || sessionId.startsWith("--")) {
        fail("sessions monitor list requires a sessionId");
      }
      return { action: "list", sessionId };
    }
    case "stop": {
      const monitorId = rest[0];
      if (!monitorId || monitorId.startsWith("--")) {
        fail("sessions monitor stop requires a monitorId");
      }
      return { action: "stop", monitorId };
    }
    default:
      fail(`Unknown sessions monitor command: ${command}\n${USAGE}`);
  }
}

export async function runMonitor(argv, serverUrl) {
  const parsed = parseMonitor(argv);
  if (parsed.action === "start") {
    const route = `/api/sessions/${parsed.sessionId}/monitors`;
    const { response, result } = await postJson(serverUrl, route, parsed.body);
    if (response.status >= 400) {
      fail(
        serverError(result, `Failed to start monitor (HTTP ${response.status})`)
      );
    }
    const monitor = result?.monitor;
    if (!monitor || typeof monitor.id !== "string") {
      fail("Server did not return a monitor id");
    }
    process.stdout.write(`Started monitor ${monitor.id}\n`);
    process.stdout.write(`  description=${JSON.stringify(monitor.description)}\n`);
    process.stdout.write(`  command=${JSON.stringify(monitor.command)}\n`);
    // Issue #351: when the monitor has an `--on-line` filter, echo
    // it so the agent can confirm the pattern landed. `null` means
    // no filter — every line is captured as a `monitor_event` but
    // none are re-injected as user turns.
    if (typeof monitor.onLinePattern === "string" && monitor.onLinePattern) {
      process.stdout.write(`  onLine=${JSON.stringify(monitor.onLinePattern)}\n`);
    }
    return;
  }
  if (parsed.action === "list") {
    const route = `/api/sessions/${parsed.sessionId}/monitors`;
    const { response, result } = await getJson(serverUrl, route);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to list monitors (HTTP ${response.status})`));
    }
    const monitors = Array.isArray(result?.monitors) ? result.monitors : [];
    if (monitors.length === 0) {
      process.stdout.write("No monitors.\n");
      return;
    }
    for (const monitor of monitors) {
      process.stdout.write(`${formatMonitorRow(monitor)}\n`);
    }
    return;
  }
  // stop — the monitor id is globally unique, so the route lives at
  // `/api/sessions/monitors/<id>` (no session id needed in the URL).
  const route = `/api/sessions/monitors/${parsed.monitorId}`;
  const { response, result } = await deleteJson(serverUrl, route);
  if (response.status >= 400) {
    fail(serverError(result, `Failed to stop monitor (HTTP ${response.status})`));
  }
  process.stdout.write("Monitor stopped.\n");
}

function formatMonitorRow(monitor) {
  const sessionId = monitor.sessionId ?? "?";
  const description = monitor.description ?? "";
  const command = monitor.command ?? "";
  const lineCount = monitor.lineCount ?? 0;
  const persistent = monitor.persistent ? "persistent" : "transient";
  // Issue #351: when the monitor has an `--on-line` filter, surface
  // it as a third line so the agent can read the active pattern at a
  // glance. When the field is absent (older server, or a monitor
  // started without the flag), the line is omitted entirely — the
  // absence is itself a signal that "this monitor does not re-inject
  // matched lines as user messages".
  const onLine =
    typeof monitor.onLinePattern === "string" && monitor.onLinePattern
      ? `\n  onLine: ${monitor.onLinePattern}`
      : "";
  return `${monitor.id}  [${persistent}]  session=${sessionId}  lines=${lineCount}\n  description: ${description}\n  command: ${command}${onLine}`;
}

// --- schedules surface (issue #243) ---

// Mirror of `presetToCron` in `server/lib/schedule-cron.ts`. The CLI is
// dependency-free and can't import the server module, so the structured
// `--every` / `--on-day` presets are translated to cron here and sent over
// the wire as a plain cron string. Keep the two in sync.
export function presetToCron({ every, onDay, atHour, atMinute }) {
  const minute = clampInt(atMinute ?? 0, 0, 59);
  const hour = clampInt(atHour ?? 9, 0, 23);
  switch (every) {
    case "minute":
      return "* * * * *";
    case "hour":
      return `${minute} * * * *`;
    case "day":
      return `${minute} ${hour} * * *`;
    case "weekday":
      return `${minute} ${hour} * * 1-5`;
    default:
      if (onDay != null) return `${minute} ${hour} * * ${clampInt(onDay, 0, 6)}`;
      return null;
  }
}

function clampInt(value, min, max) {
  const n = Math.trunc(Number(value));
  if (Number.isNaN(n)) return min;
  return Math.min(max, Math.max(min, n));
}

export function parseSchedules(argv) {
  const [command, ...rest] = argv;
  if (!command) fail(`Unknown schedules command\n${USAGE}`);
  // `<project>` is the optional first positional. If the next token
  // starts with `--` (or is missing), the user didn't supply a project
  // and the run path falls back to cwd.
  let project = "";
  let args = rest;
  if (rest[0] !== undefined && !rest[0].startsWith("--")) {
    project = rest[0];
    args = rest.slice(1);
  }
  switch (command) {
    case "list":
      return { project, action: "list", includeDisabled: !args.includes("--enabled-only") };
    case "show":
      if (!args[0]) fail("schedules show requires a <scheduleId>");
      return { project, action: "show", scheduleId: args[0] };
    case "runs":
      if (!args[0]) fail("schedules runs requires a <scheduleId>");
      return { project, action: "runs", scheduleId: args[0] };
    case "enable":
      if (!args[0]) fail("schedules enable requires a <scheduleId>");
      return { project, action: "enable", scheduleId: args[0] };
    case "disable":
      if (!args[0]) fail("schedules disable requires a <scheduleId>");
      return { project, action: "disable", scheduleId: args[0] };
    case "remove":
      if (!args[0]) fail("schedules remove requires a <scheduleId>");
      return { project, action: "remove", scheduleId: args[0] };
    case "add": {
      assertKnownFlags(
        args,
        [
          "--worktree",
          "--prompt",
          "--at",
          "--cron",
          "--every",
          "--on-day",
          "--at-hour",
          "--at-minute",
          "--timezone",
          "--provider",
          "--agent",
          "--model",
          "--mode",
          "--enabled",
          "--source",
        ],
        "schedules add"
      );
      const worktreeId = flagValue(args, "--worktree");
      if (!worktreeId) fail("schedules add requires --worktree <worktreeId>");
      const prompt = flagValue(args, "--prompt");
      if (!prompt || !prompt.trim()) fail("schedules add requires --prompt <text>");

      const at = flagValue(args, "--at");
      const explicitCron = flagValue(args, "--cron");
      const every = flagValue(args, "--every");
      const onDay = flagValue(args, "--on-day");
      // An explicit --cron wins; otherwise derive one from the structured
      // preset flags. Falling through to neither means a one-shot --at.
      let cron = explicitCron ?? null;
      if (!cron && (every || onDay != null)) {
        cron = presetToCron({
          every,
          onDay: onDay != null ? Number(onDay) : undefined,
          atHour: flagValue(args, "--at-hour"),
          atMinute: flagValue(args, "--at-minute"),
        });
        if (!cron) fail("schedules add: --every must be minute|hour|day|weekday, or pass --on-day <0-6>");
      }
      if (!cron && !at) {
        fail("schedules add requires --at <iso> (one-shot) or --cron/--every (recurring)");
      }

      const timezone = flagValue(args, "--timezone");
      // `--agent` is a forgiving alias for `--provider` (issue #306). When
      // both are passed with the same value, accept; otherwise fail loudly
      // so a stray typo doesn't silently swap the scheduled provider.
      const providerFromFlag = flagValue(args, "--provider");
      const providerFromAlias = flagValue(args, "--agent");
      let provider = undefined;
      if (providerFromFlag != null && providerFromAlias != null) {
        if (providerFromFlag !== providerFromAlias) {
          fail(
            `schedules add: --provider (${providerFromFlag}) and --agent (${providerFromAlias}) disagree. ` +
              `Pass only one of them.`
          );
        }
        provider = providerFromFlag;
      } else {
        provider = providerFromFlag ?? providerFromAlias;
      }
      const model = flagValue(args, "--model");
      const mode = flagValue(args, "--mode");
      const enabled = flagValue(args, "--enabled");
      const source = flagValue(args, "--source");

      return {
        project,
        action: "add",
        body: {
          worktreeId,
          prompt,
          ...(cron ? { cron } : {}),
          ...(at ? { runAt: at } : {}),
          ...(timezone ? { timezone } : {}),
          ...(provider ? { provider } : {}),
          ...(model ? { model } : {}),
          ...(mode ? { mode } : {}),
          ...(enabled != null ? { enabled: enabled === "true" } : {}),
          ...(source ? { source } : {}),
          createdBy: "cli",
        },
      };
    }
    default:
      fail(`Unknown schedules command: ${command}\n${USAGE}`);
  }
}

function formatScheduleRow(schedule) {
  const repeat = schedule.cron ? `cron=${schedule.cron} (${schedule.timezone})` : `at=${schedule.runAt}`;
  const state = schedule.enabled ? "enabled" : "disabled";
  const err = schedule.lastError ? `  lastError=${schedule.lastError}` : "";
  return `${schedule.id}  [${state}]  ${repeat}\n  next=${schedule.nextRunAt}  worktree=${schedule.worktreeId}\n  prompt: ${schedule.prompt}${err}`;
}

export async function runSchedules(argv, serverUrl) {
  const parsed = parseSchedules(argv);
  const projectId = await resolveProjectId(serverUrl, parsed.project);
  const base = `/api/projects/${projectId}/schedules`;

  if (parsed.action === "list") {
    const { response, result } = await getJson(
      serverUrl,
      `${base}?includeDisabled=${parsed.includeDisabled ? "true" : "false"}`
    );
    if (response.status >= 400) {
      fail(serverError(result, `Failed to list schedules (HTTP ${response.status})`));
    }
    const schedules = Array.isArray(result) ? result : [];
    if (schedules.length === 0) {
      process.stdout.write("No schedules.\n");
      return;
    }
    for (const schedule of schedules) {
      process.stdout.write(`${formatScheduleRow(schedule)}\n`);
    }
    return;
  }

  if (parsed.action === "show") {
    const { response, result } = await getJson(serverUrl, `${base}/${parsed.scheduleId}`);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to load schedule (HTTP ${response.status})`));
    }
    process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
    return;
  }

  if (parsed.action === "runs") {
    const { response, result } = await getJson(serverUrl, `${base}/${parsed.scheduleId}/runs`);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to load runs (HTTP ${response.status})`));
    }
    const runs = Array.isArray(result) ? result : [];
    if (runs.length === 0) {
      process.stdout.write("No runs yet.\n");
      return;
    }
    for (const run of runs) {
      const outcome = run.error ? `error: ${run.error}` : `session=${run.sessionId}`;
      process.stdout.write(`${run.firedAt}  ${outcome}\n`);
    }
    return;
  }

  if (parsed.action === "add") {
    const { response, result } = await postJson(serverUrl, base, parsed.body);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to add schedule (HTTP ${response.status})`));
    }
    process.stdout.write(`Created schedule ${result.id}\n  next run: ${result.nextRunAt}\n`);
    return;
  }

  if (parsed.action === "enable" || parsed.action === "disable") {
    const { response, result } = await postJson(
      serverUrl,
      `${base}/${parsed.scheduleId}/${parsed.action}`,
      {}
    );
    if (response.status >= 400) {
      fail(serverError(result, `Failed to ${parsed.action} schedule (HTTP ${response.status})`));
    }
    process.stdout.write(`Schedule ${parsed.action}d.\n`);
    return;
  }

  if (parsed.action === "remove") {
    const { response, result } = await deleteJson(serverUrl, `${base}/${parsed.scheduleId}`);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to remove schedule (HTTP ${response.status})`));
    }
    process.stdout.write("Removed schedule.\n");
    return;
  }

  fail(`Unknown schedules action: ${parsed.action}`);
}

// --- memory surface (issue #350) ---
//
// `controller memory <action>` reads/writes the Controller-owned memory
// layer. The scope is `global` (cross-session) or `project` (per
// onboarded project, requires `--project <id>`). When the CLI is
// invoked from inside a session's worktree and the user passes
// `scope=project` without `--project`, the server resolves the
// project from the session. Otherwise the user must supply it
// explicitly.

function parseScope(raw, allowProject) {
  if (raw === "global") return "global";
  if (allowProject && raw === "project") return "project";
  return null;
}

function buildMemoryQuery(parsed) {
  const params = new URLSearchParams();
  params.set("scope", parsed.scope);
  if (parsed.projectId) params.set("projectId", parsed.projectId);
  if (parsed.query) params.set("query", parsed.query);
  if (parsed.limit != null) params.set("limit", String(parsed.limit));
  return params.toString();
}

export function parseMemory(argv) {
  const [command, ...rest] = argv;
  switch (command) {
    case "list": {
      // `list --scope <global|projectId>` per the issue spec. The scope
      // is a flag so the common case `controller memory list` doesn't
      // have to type `--scope global` every time.
      const scopeFlag = flagValue(rest, "--scope");
      const projectFlag = flagValue(rest, "--project");
      const includePinned = rest.includes("--include-pinned");
      // `--scope <projectId>` (no `global` literal) means project.
      // Anything else defaults to `global` so a typo falls back to
      // the global catalog rather than silently producing an empty
      // list.
      let scope = "global";
      if (scopeFlag) {
        if (scopeFlag === "global") scope = "global";
        else if (scopeFlag === "project") scope = "project";
        else scope = "project"; // treat the value as a projectId
      }
      return {
        action: "list",
        scope,
        projectId: scope === "project" ? (scopeFlag && scopeFlag !== "project" ? scopeFlag : projectFlag) ?? null : undefined,
        includePinned,
      };
    }
    case "read": {
      // `<scope>` is positional; `project` is the second valid value
      // alongside `global` (PR review, P1).
      const scope = parseScope(rest[0], true);
      if (!scope) fail("memory read requires <scope> as the first positional");
      const slug = rest[1];
      if (!slug) fail("memory read requires a <slug>");
      const projectId = flagValue(rest.slice(2), "--project");
      return {
        action: "read",
        scope,
        slug,
        projectId: scope === "project" ? projectId ?? null : undefined,
      };
    }
    case "search": {
      // `search --scope <global|projectId> <query>`. Scope is a flag
      // (default `global`); the query is the leftover positional text.
      // Use the shared flag-collector so unknown flags still error.
      assertKnownFlags(rest, ["--scope", "--project", "--limit"], "memory search");
      const scopeFlag = flagValue(rest, "--scope");
      const projectFlag = flagValue(rest, "--project");
      const limitFlag = flagValue(rest, "--limit");
      let scope = "global";
      if (scopeFlag) {
        if (scopeFlag === "global") scope = "global";
        else if (scopeFlag === "project") scope = "project";
        else scope = "project";
      }
      // The query is everything that isn't a known flag or the value
      // consumed by a known flag. Build an index of consumed positions
      // to filter them out cleanly.
      const flagNames = new Set(["--scope", "--project", "--limit"]);
      const skip = new Set();
      for (let i = 0; i < rest.length; i += 1) {
        if (flagNames.has(rest[i])) {
          skip.add(i);
          if (rest[i + 1] !== undefined && !rest[i + 1].startsWith("--")) {
            skip.add(i + 1);
          }
        }
      }
      const query = rest.filter((_, i) => !skip.has(i)).join(" ").trim();
      if (!query) fail("memory search requires a <query>");
      return {
        action: "search",
        scope,
        projectId: scope === "project" ? (scopeFlag && scopeFlag !== "project" ? scopeFlag : projectFlag) ?? null : undefined,
        query,
        limit: limitFlag ? Number(limitFlag) : null,
      };
    }
    case "write": {
      const scope = parseScope(rest[0], true);
      if (!scope) fail("memory write requires <scope> as the first positional");
      const slug = rest[1];
      if (!slug) fail("memory write requires a <slug>");
      const writeArgs = rest.slice(2);
      // `--content=-` (one token) means "read the body from stdin",
      // matching the `--scheme-secret=-` idiom from `integrations
      // create`. Split the `=` form so `flagValue` can see the value.
      const expanded = expandEqualsForm(writeArgs, MEMORY_VALUE_FLAGS);
      assertKnownFlags(
        expanded,
        ["--content", "--content-file", "--project"],
        "memory write"
      );
      const contentFlag = flagValue(expanded, "--content");
      const contentFile = flagValue(expanded, "--content-file");
      const projectId = flagValue(expanded, "--project");
      if (contentFlag == null && !contentFile) {
        fail("memory write requires --content <text> or --content-file <path>");
      }
      if (contentFlag != null && contentFile) {
        fail("memory write accepts only one of --content or --content-file");
      }
      return {
        action: "write",
        scope,
        slug,
        projectId: scope === "project" ? projectId ?? null : undefined,
        body: { contentFlag, contentFile, projectId },
      };
    }
    case "pinned": {
      const scope = parseScope(rest[0], true);
      if (!scope) fail("memory pinned requires <scope> as the first positional");
      const projectId = flagValue(rest.slice(1), "--project");
      return {
        action: "pinned",
        scope,
        projectId: scope === "project" ? projectId ?? null : undefined,
      };
    }
    case "pin": {
      const scope = parseScope(rest[0], true);
      if (!scope) fail("memory pin requires <scope> as the first positional");
      const pinArgs = rest.slice(1);
      // Same `--content=-` stdin idiom as `write` (PR review, P2).
      const expanded = expandEqualsForm(pinArgs, MEMORY_VALUE_FLAGS);
      assertKnownFlags(expanded, ["--content", "--content-file", "--project"], "memory pin");
      const contentFlag = flagValue(expanded, "--content");
      const contentFile = flagValue(expanded, "--content-file");
      const projectId = flagValue(expanded, "--project");
      if (contentFlag == null && !contentFile) {
        fail("memory pin requires --content <text> or --content-file <path>");
      }
      if (contentFlag != null && contentFile) {
        fail("memory pin accepts only one of --content or --content-file");
      }
      return {
        action: "pin",
        scope,
        projectId: scope === "project" ? projectId ?? null : undefined,
        body: { contentFlag, contentFile, projectId },
      };
    }
    default:
      fail(`Unknown memory command: ${command ?? ""}\n${USAGE}`);
  }
}

// Flags that accept a value in `--flag=value` shorthand. The memory
// write/pin forms use the same `=`-form as the integrations create
// surface (e.g. `--scheme-secret=-`); `expandEqualsForm` splits those
// into two tokens so `flagValue` can see the value.
const MEMORY_VALUE_FLAGS = new Set(["--content", "--content-file", "--project"]);

async function readMemoryContent({ contentFlag, contentFile }) {
  // The literal `-` (set when the user wrote `--content=-`) means
  // "read the body from stdin" — same idiom as
  // `--scheme-secret=-` on the integrations surface. We strip a
  // single trailing newline so the common `echo "$body" | controller
  // ...` pattern doesn't pick up an extra `\n`.
  if (contentFlag === "-") {
    const chunks = [];
    for await (const chunk of process.stdin) {
      chunks.push(typeof chunk === "string" ? Buffer.from(chunk) : chunk);
    }
    return Buffer.concat(chunks).toString("utf-8").replace(/\r?\n$/, "");
  }
  if (contentFlag != null) return contentFlag;
  if (contentFile) {
    try {
      const fs = await import("node:fs/promises");
      return (await fs.readFile(contentFile, "utf-8")).replace(/\r?\n$/, "");
    } catch (error) {
      fail(`Could not read content file: ${error?.message ?? error}`);
    }
  }
  return "";
}

function formatMemoryEntry(entry) {
  const scope = entry.scope === "global" ? "global" : `project:${entry.projectId ?? "?"}`;
  const preview = entry.preview ? `  ${entry.preview}` : "";
  return `${scope}  ${entry.slug}${preview}`;
}

export async function runMemory(argv, serverUrl) {
  const parsed = parseMemory(argv);

  // Resolve the project id lazily, only for project-scope calls
  // (PR review, P2). The worktrees surface resolves unconditionally
  // because it always needs a project; memory doesn't, so we defer
  // until we know we need one. `resolveProjectId` is the same cwd
  // → project resolver `runWorktrees` uses, so an agent inside a
  // worktree can omit `--project` and the CLI picks the project
  // that owns cwd. The fallback fails the process with a clear
  // error if cwd is not part of any onboarded project, matching
  // the worktrees UX.
  const projectId = parsed.scope === "project"
    ? await resolveProjectId(serverUrl, parsed.projectId ?? undefined)
    : undefined;

  if (parsed.action === "list") {
    const query = buildMemoryQuery({
      scope: parsed.scope,
      projectId,
    });
    const path = `/api/memory?${query}${parsed.includePinned ? `${query ? "&" : ""}includePinned=1` : ""}`;
    const { response, result } = await getJson(serverUrl, path);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to list memory (HTTP ${response.status})`));
    }
    const entries = Array.isArray(result?.entries) ? result.entries : [];
    if (parsed.includePinned && typeof result?.pinned === "string") {
      process.stdout.write(`# pinned.md\n${result.pinned}\n\n# notes\n`);
    }
    if (entries.length === 0) {
      process.stdout.write(parsed.includePinned ? "" : "No memory notes.\n");
      return;
    }
    for (const entry of entries) {
      process.stdout.write(`${formatMemoryEntry(entry)}\n`);
    }
    return;
  }

  if (parsed.action === "read") {
    const query = buildMemoryQuery({
      scope: parsed.scope,
      projectId,
    });
    const path = `/api/memory/${parsed.scope}/${encodeURIComponent(parsed.slug)}?${query}`;
    const { response, result } = await getJson(serverUrl, path);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to read memory (HTTP ${response.status})`));
    }
    process.stdout.write(result?.content ?? "");
    return;
  }

  if (parsed.action === "search") {
    const query = buildMemoryQuery({
      scope: parsed.scope,
      projectId,
      query: parsed.query,
      limit: parsed.limit,
    });
    const path = `/api/memory/${parsed.scope}/search?${query}`;
    const { response, result } = await getJson(serverUrl, path);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to search memory (HTTP ${response.status})`));
    }
    const hits = Array.isArray(result?.results) ? result.results : [];
    if (hits.length === 0) {
      process.stdout.write("No matches.\n");
      return;
    }
    for (const hit of hits) {
      process.stdout.write(`${formatMemoryEntry(hit)}\n`);
    }
    return;
  }

  if (parsed.action === "write") {
    const content = await readMemoryContent(parsed.body);
    const path = `/api/memory/${parsed.scope}/${encodeURIComponent(parsed.slug)}`;
    const { response, result } = await putJson(serverUrl, path, {
      content,
      ...(projectId ? { projectId } : {}),
    });
    if (response.status >= 400) {
      fail(serverError(result, `Failed to write memory (HTTP ${response.status})`));
    }
    process.stdout.write(`Wrote memory note "${parsed.slug}".\n`);
    return;
  }

  if (parsed.action === "pinned") {
    const query = buildMemoryQuery({
      scope: parsed.scope,
      projectId,
    });
    const path = `/api/memory/${parsed.scope}/pinned?${query}`;
    const { response, result } = await getJson(serverUrl, path);
    if (response.status >= 400) {
      fail(serverError(result, `Failed to read pinned memory (HTTP ${response.status})`));
    }
    process.stdout.write(result?.content ?? "");
    return;
  }

  if (parsed.action === "pin") {
    const content = await readMemoryContent(parsed.body);
    const path = `/api/memory/${parsed.scope}/pinned`;
    const { response, result } = await putJson(serverUrl, path, {
      content,
      ...(projectId ? { projectId } : {}),
    });
    if (response.status >= 400) {
      fail(serverError(result, `Failed to write pinned memory (HTTP ${response.status})`));
    }
    process.stdout.write(`Updated pinned memory for ${parsed.scope}.\n`);
    return;
  }

  fail(`Unknown memory action: ${parsed.action}`);
}

// --- browser surface (issue #109) ---

export function parseBrowser(argv) {
  const [command, ...rest] = argv;
  switch (command) {
    case "open": {
      if (!rest[0]) fail("browser open requires a <url>");
      // `--insecure` opts into bypassing TLS-cert validation on the preview
      // session for this navigation (issue #323). Scoped to localhost URLs
      // by the server-side policy and the Electron cert-verify bypass; an
      // external URL with `--insecure` is rejected with a clear error.
      const insecure = rest.includes("--insecure");
      const positional = rest.filter((a) => a !== "--insecure");
      return {
        action: "open",
        params: { url: positional[0], insecure },
      };
    }
    case "snapshot": {
      // --a11y switches the response shape to a structured accessibility
      // tree (issue #170). The default mode still emits refs in its
      // interactive-elements listing, so the agent only needs --a11y when
      // it wants the full tree.
      const a11y = rest.includes("--a11y");
      const positional = rest.filter((a) => a !== "--a11y");
      return {
        action: "snapshot",
        params: {
          ...(positional[0] ? { selector: positional[0] } : {}),
          a11y,
        },
      };
    }
    case "click": {
      if (!rest[0]) fail("browser click requires a <selector>");
      return { action: "click", params: { selector: rest[0] } };
    }
    case "type": {
      const submit = rest.includes("--submit");
      const positional = rest.filter((a) => a !== "--submit");
      if (!positional[0]) fail("browser type requires a <selector>");
      return { action: "type", params: { selector: positional[0], text: positional.slice(1).join(" "), submit } };
    }
    case "set-files": {
      // `controller browser set-files <selector> <path> [--path <path> ...]
      //  [--allow-outside]` (issue #356).
      //
      // The first positional is the selector; the second is a required
      // initial path (so the natural invocation `set-files ref=e3 /a.png`
      // works without typing `--path` for the common single-file case).
      // Subsequent paths are appended via `--path` so the agent can pass
      // any number of files without ambiguity. The flag is the same
      // shape as `open --insecure`: server-side pre-check + Electron
      // main process re-check, so outside-the-worktree access is
      // explicit on both ends.
      if (!rest[0]) fail("browser set-files requires a <selector>");
      const selector = rest[0];
      const paths = [];
      let allowOutside = false;
      // Walk the rest starting at index 1; everything that doesn't look
      // like a known flag and isn't the second positional is treated as
      // a path. We keep the loop explicit (rather than reusing
      // `assertKnownFlags` / `flagValue`) because the second positional
      // is the only one that's required — every other path is opt-in.
      let i = 1;
      // Initial positional path. Accept any token that isn't `--path` /
      // `--allow-outside`; an omitted initial path is a user error so
      // the failure mode reads naturally.
      if (rest[i] && !rest[i].startsWith("--")) {
        paths.push(rest[i]);
        i += 1;
      } else {
        fail(
          "browser set-files requires a <path> after the selector " +
            "(use --path <path> to attach additional files)"
        );
      }
      while (i < rest.length) {
        const arg = rest[i];
        if (arg === "--path") {
          const next = rest[i + 1];
          if (!next || next.startsWith("--")) {
            fail("browser set-files: --path requires a value");
          }
          paths.push(next);
          i += 2;
          continue;
        }
        if (arg === "--allow-outside") {
          allowOutside = true;
          i += 1;
          continue;
        }
        if (arg.startsWith("--")) {
          fail(
            `Unknown flag for browser set-files: ${arg}\n` +
              `Valid flags: --path, --allow-outside`
          );
        }
        fail(
          `browser set-files: unexpected positional argument "${arg}" ` +
            `(use --path <path> to attach additional files)`
        );
      }
      if (paths.length === 0) {
        fail("browser set-files requires at least one <path>");
      }
      return {
        action: "setFiles",
        params: { selector, paths, allowOutside },
      };
    }
    default:
      fail(`Unknown browser command: ${command ?? ""}\n${USAGE}`);
  }
}

async function runBrowser(argv, serverUrl) {
  const { action, params } = parseBrowser(argv);
  const { response, result } = await postJson(serverUrl, "/api/browser/command", { action, params });
  if (!result || result.ok === false) {
    fail(serverError(result, `Browser command failed (HTTP ${response.status})`));
  }
  if (action === "snapshot") {
    const header = [result.title, result.url].filter(Boolean).join(" — ");
    if (header) process.stdout.write(`${header}\n\n`);
    process.stdout.write(`${result.text ?? ""}\n`);
    if (result.refCount && result.refCount > 0) {
      process.stdout.write(`\n${result.refCount} ref(s) registered — use \`click ref=e1\` or \`type ref=e1 <text>\` to target them.\n`);
    }
    return;
  }
  const lines = [];
  if (result.summary) lines.push(result.summary);
  if (result.title) lines.push(`Title: ${result.title}`);
  if (result.url) lines.push(`URL: ${result.url}`);
  // `setFiles` returns a per-file outcome so the agent can detect
  // rejections (size/type/validation) without re-snapping. Print each
  // row so the human watching the terminal sees what landed on the
  // input — accepted files appear as "ok", rejections as a one-liner
  // with the page-observed reason.
  if (action === "setFiles" && Array.isArray(result.files)) {
    for (const entry of result.files) {
      if (entry && entry.accepted) {
        lines.push(`  ✓ ${entry.name} (${entry.path ?? ""})`);
      } else if (entry) {
        lines.push(`  ✗ ${entry.name}: ${entry.reason ?? "rejected"}`);
      }
    }
  }
  process.stdout.write(`${lines.join("\n") || "OK"}\n`);
}

// --- terminal surface (issue #261) ---

// Collect positional args, skipping known flags. `valueFlags` consume the
// following token; `boolFlags` are standalone. Lets `snapshot`/`tail` accept
// `--lines`/`--follow` in any position without swallowing the terminal id.
function positionalArgs(rest, valueFlags = [], boolFlags = []) {
  const out = [];
  for (let i = 0; i < rest.length; i += 1) {
    if (boolFlags.includes(rest[i])) continue;
    if (valueFlags.includes(rest[i])) {
      i += 1;
      continue;
    }
    out.push(rest[i]);
  }
  return out;
}

export function parseTerminal(argv) {
  const [command, ...rest] = argv;
  switch (command) {
    case "list":
      return { action: "list", params: {} };
    case "run": {
      const [terminalId, ...commandParts] = rest;
      if (!terminalId) fail("terminal run requires a <terminalId>");
      // Everything after the id is the command, verbatim, so the agent can
      // quote it normally (e.g. `terminal run build "npm run dev"`).
      const command = commandParts.join(" ").trim();
      if (!command) fail("terminal run requires a <command>");
      return { action: "run", params: { terminalId, command } };
    }
    case "snapshot": {
      const positional = positionalArgs(rest, ["--lines"]);
      const terminalId = positional[0];
      if (!terminalId) fail("terminal snapshot requires a <terminalId>");
      const lines = flagValue(rest, "--lines");
      return {
        action: "snapshot",
        params: { terminalId, ...(lines !== undefined ? { lines: Number(lines) } : {}) },
      };
    }
    case "tail": {
      const positional = positionalArgs(rest, [], ["--follow"]);
      const terminalId = positional[0];
      if (!terminalId) fail("terminal tail requires a <terminalId>");
      return { action: "tail", params: { terminalId, follow: rest.includes("--follow") } };
    }
    default:
      fail(`Unknown terminal command: ${command ?? ""}\n${USAGE}`);
  }
}

function printTerminal(action, result) {
  if (action === "list") {
    const terminals = result.terminals ?? [];
    if (terminals.length === 0) {
      process.stdout.write("No terminals are open in this worktree.\n");
      return;
    }
    for (const t of terminals) {
      process.stdout.write(`${t.id}${t.attached ? "  [attached]" : ""}\n`);
    }
    return;
  }
  if (action === "run") {
    process.stdout.write(`Sent to ${result.terminalId}: ${result.sent}\n`);
    return;
  }
  if (action === "snapshot") {
    const text = result.text ?? "";
    process.stdout.write(text.endsWith("\n") || text === "" ? text : `${text}\n`);
    return;
  }
}

export async function runTerminal(argv, serverUrl) {
  const { action, params } = parseTerminal(argv);
  if (action === "tail") {
    await runTerminalTail(serverUrl, params);
    return;
  }
  const { response, result } = await postJson(serverUrl, "/api/terminal/command", { action, params });
  if (!result || result.ok === false) {
    fail(serverError(result, `Terminal command failed (HTTP ${response.status})`));
  }
  printTerminal(action, result);
}

// `tail` is a streaming response: read chunks as they arrive and write them
// straight through. `--follow` keeps the server stream open until the user
// interrupts the CLI; without it the server ends the stream after a short idle.
async function runTerminalTail(serverUrl, params) {
  let response;
  try {
    response = await fetch(`${serverUrl.replace(/\/$/, "")}/api/terminal/command`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ action: "tail", params, cwd: process.cwd() }),
    });
  } catch (error) {
    fail(`Could not reach the orchestrator: ${error?.message ?? error}`);
  }
  if (response.status >= 400) {
    let message = `Terminal tail failed (HTTP ${response.status})`;
    try {
      const parsed = await response.json();
      if (parsed && parsed.error) message = parsed.error;
    } catch {}
    fail(message);
  }
  if (!response.body) {
    fail("Terminal tail returned no stream");
  }
  const reader = response.body.getReader();
  const decoder = new TextDecoder();
  for (;;) {
    const { value, done } = await reader.read();
    if (done) break;
    process.stdout.write(decoder.decode(value, { stream: true }));
  }
}

// --- integrations surface (issue #130) ---

function parsePairs(rest, flag) {
  const out = {};
  for (let i = 0; i < rest.length; i += 1) {
    if (rest[i] === flag && rest[i + 1]) {
      const eq = rest[i + 1].indexOf("=");
      if (eq > 0) out[rest[i + 1].slice(0, eq)] = rest[i + 1].slice(eq + 1);
      i += 1;
    }
  }
  return out;
}

function flagValue(rest, flag) {
  const idx = rest.indexOf(flag);
  return idx >= 0 ? rest[idx + 1] : undefined;
}

// Count the number of consecutive non-`--…` tokens at the front of
// `argv` (issue #355). Used by `parseSessions` to disambiguate the
// optional `<project>` positional from the message positional on
// `start`: with 0 leading bare tokens there's no project and no
// message; with 1 leading bare token the agent wrote the message
// first; with 2 leading bare tokens the first is the project and the
// second is the message. The helper stops counting at the first
// `--…` token so flag pairs interleaved at the front don't throw off
// the result.
function countLeadingBareTokens(argv) {
  let n = 0;
  for (const arg of argv) {
    if (typeof arg === "string" && arg.startsWith("--")) break;
    n += 1;
  }
  return n;
}

// Pull the message positional and the flag-pair slice out of an args
// array for `sessions start` / `sessions wake` (issue #355). The
// positional can sit before or after the flag pairs (so a message like
// `"Fix issue #351"` either ends the argv or starts it), and every
// non-`--…` token that is NOT the positional is consumed as the value
// of the preceding known flag. A stray bare token that's not a flag
// value and not the positional is rejected with a clear "unexpected
// positional after the message" error so the user can fix the call.
//
// The walker also honors the standard `--` end-of-flags marker: any
// token after `--` is appended verbatim to the message, joined with
// spaces. That covers the corner case where a prompt happens to
// start with `--…` (e.g. `wake sess-1 "--help me diagnose"`, or
// `wake sess-1 -- --help me diagnose`), so the user can opt out of
// the flag-shape disambiguation for prompts whose first characters
// look flag-like. `git`, `kubectl`, and `gh` use the same convention.
//
// We walk argv once, tracking the index of the message positional and
// every flag / flag-value pair. Walking (rather than slicing from a
// found index) keeps flag values like `wt-123` from being mistaken
// for the message — a previous version used a `findIndex` and ate the
// first flag value as the message, which is the bug this helper was
// extracted to prevent.
function extractMessageAndFlagArgs(args, knownFlags, commandLabel) {
  const knownSet = new Set(knownFlags);
  const flagArgs = [];
  // Index of the message positional in `args`. There is at most one;
  // a second bare token after the first one is rejected below.
  let messageIdx = -1;
  // When set, the next non-`--…` token is the value of `pendingFlag`
  // and is appended to `flagArgs` (consumed), not inspected as a
  // candidate for the positional or a stray-token error.
  let pendingFlag = null;
  // When set, every remaining token — including ones starting with
  // `--` — is appended verbatim to the message. Set on encountering
  // the bare `--` token (the standard end-of-flags marker).
  let endOfFlags = false;
  // Tokens collected after `--` are appended to the message verbatim
  // (joined with spaces). We track them separately so the caller's
  // `args[messageIdx]` join still works the same way.
  let endOfFlagsTokens = null;
  for (let i = 0; i < args.length; i += 1) {
    const arg = args[i];
    if (endOfFlags) {
      endOfFlagsTokens.push(arg);
      continue;
    }
    if (pendingFlag) {
      // The next arg is the value for `pendingFlag` — even if it
      // doesn't start with `--`, it's already claimed by the flag
      // (e.g. `--worktree wt-123`).
      flagArgs.push(pendingFlag);
      flagArgs.push(arg);
      pendingFlag = null;
      continue;
    }
    if (typeof arg === "string" && arg === "--") {
      // End-of-flags marker. Everything from here on out is the
      // message, verbatim — including flag-shaped tokens. We
      // synthesize the message here only if no earlier positional
      // existed; otherwise the `--` is rejected below as a stray
      // trailing token (consistent with "one positional only").
      if (messageIdx >= 0) {
        fail(
          `Unexpected positional argument after the message: "${arg}". ` +
            `Only one positional (the prompt) is allowed; pass any extra flags before or after it.`
        );
      }
      endOfFlags = true;
      messageIdx = i;
      endOfFlagsTokens = [];
      continue;
    }
    if (typeof arg === "string" && arg.startsWith("--")) {
      if (!knownSet.has(arg)) {
        fail(
          `Unknown flag for ${commandLabel}: ${arg}\n` +
            `Valid flags: ${knownFlags.join(", ")}`
        );
      }
      // Every known flag in this list takes a value. The old `--message`
      // bool flag is gone; in the positional model the message arg is
      // not a flag at all.
      pendingFlag = arg;
      continue;
    }
    // Bare (non-`--…`) token. It's either the first positional we've
    // seen (the message), or it's a stray second positional — the
    // issue's "one positional only" rule rejects the latter.
    if (messageIdx < 0) {
      messageIdx = i;
      continue;
    }
    fail(
      `Unexpected positional argument after the message: "${arg}". ` +
        `Only one positional (the prompt) is allowed; pass any extra flags before or after it.`
    );
  }
  if (pendingFlag) {
    fail(`${commandLabel}: ${pendingFlag} requires a value`);
  }
  if (messageIdx < 0) {
    fail(
      "Missing message: the last positional argument is the prompt to send the agent. " +
        `Example: controller ${commandLabel} <message> [${knownFlags.join(" ")} ...] ` +
        `(use -- to pass a prompt that begins with --, e.g. ${commandLabel} ... -- "--help me")`
    );
  }
  if (endOfFlags) {
    // `--` doesn't appear in the message itself — it's just a marker.
    // The tokens after it join with spaces (the same shape a quoted
    // prompt has when handed to the CLI by a shell).
    return { message: endOfFlagsTokens.join(" "), flagArgs };
  }
  return { message: args[messageIdx], flagArgs };
}

// Resolve the `--parent <value>` flag (issue #353). `value` is either
// `undefined` (no flag), a literal session id, or the special token
// `self`. `self` resolves to the calling session's id via the
// `$CONTROLLER_SESSION_ID` env var the orchestrator injects at agent
// spawn time. When `self` is used and the env var is not set, the CLI
// surfaces a clear error pointing at the env var — the natural
// fallback is to use `controller sessions list` to find the calling
// session's id. The function returns `undefined` when the flag is
// absent so callers can simply spread the result into an object.
function resolveParentFlag(value) {
  if (value == null) return undefined;
  if (value === "self") {
    const selfId = process.env.CONTROLLER_SESSION_ID;
    if (!selfId) {
      fail(
        "sessions: --parent self requires the CONTROLLER_SESSION_ID env var. " +
          "The orchestrator injects it when spawning an agent, so the env var " +
          "is missing here because this command is running outside the orchestrator's " +
          "agent process, or because the calling session hasn't been assigned an id yet. " +
          "Use `controller sessions list` to discover the calling session's id, then " +
          "pass it explicitly to --parent."
      );
    }
    return selfId;
  }
  return value;
}

// Fails with a clear, actionable error if `args` contains a `--…` token that
// is not in `known` (issue #306). Without this, a typo like `--agent claude`
// is silently dropped by `flagValue` and the CLI falls back to the default
// provider, masking the mistake. The error names the offending flag and
// lists the valid set so the user can fix it without reading the source.
function assertKnownFlags(args, known, command) {
  const knownSet = new Set(known);
  for (const arg of args) {
    if (arg.startsWith("--") && !knownSet.has(arg)) {
      fail(
        `Unknown flag for ${command}: ${arg}\n` +
          `Valid flags: ${known.join(", ")}`
      );
    }
  }
}

// Mirror of the `CONNECTION_MODES` and `ACQUISITIONS` enums in
// `server/routes/integrations.ts`. The CLI re-validates these so the agent
// gets immediate feedback on a typo instead of a generic 400; the server
// remains the source of truth (keeps the two in sync).
const INTEGRATION_MODES = ["mcp", "openapi", "rest", "graphql", "cli"];
const INTEGRATION_ACQUISITIONS = [
  "static",
  "basic",
  "oauth",
  "oauth_client_credentials",
  "oauth_dynamic",
  "cloud",
  "hmac",
  "mtls",
];
// Acquisitions that don't carry an attachable credential (the gateway
// reaches them through signing or the transport layer, not a header/query).
const NON_ATTACHABLE_ACQUISITIONS = new Set(["hmac", "mtls", "cloud"]);

export function parseIntegrations(argv) {
  const [command, ...rest] = argv;
  switch (command) {
    case "list":
      // `--all` switches to the registry view (full record, includes disabled).
      // Plain `list` keeps the existing gateway view (active + summary).
      if (rest.includes("--all")) {
        return { action: "registry-list", body: { json: rest.includes("--json") } };
      }
      return { action: "gateway", endpoint: "list", body: {} };
    case "search": {
      const query = rest.join(" ").trim();
      if (!query) fail("integrations search requires a <query>");
      return { action: "gateway", endpoint: "search", body: { query } };
    }
    case "tools":
      if (!rest[0]) fail("integrations tools requires an <integration>");
      return { action: "gateway", endpoint: "tools", body: { integration: rest[0] } };
    case "describe":
      if (!rest[0] || !rest[1]) fail("integrations describe requires <integration> <tool>");
      return { action: "gateway", endpoint: "describe", body: { integration: rest[0], tool: rest[1] } };
    case "call": {
      if (!rest[0] || !rest[1]) fail("integrations call requires <integration> <tool>");
      const json = flagValue(rest, "--json");
      let args = {};
      if (json) {
        try {
          args = JSON.parse(json);
        } catch {
          fail("--json must be valid JSON");
        }
      }
      return { action: "gateway", endpoint: "call", body: { integration: rest[0], tool: rest[1], args } };
    }
    case "request": {
      if (!rest[0] || !rest[1] || !rest[2]) fail("integrations request requires <integration> <METHOD> <path>");
      const data = flagValue(rest, "--data");
      let body = null;
      if (data !== undefined) {
        try {
          body = JSON.parse(data);
        } catch {
          body = data;
        }
      }
      return {
        action: "gateway",
        endpoint: "request",
        body: {
          integration: rest[0],
          method: rest[1],
          path: rest[2],
          query: parsePairs(rest, "--query"),
          headers: parsePairs(rest, "--header"),
          body,
        },
      };
    }
    case "status":
      if (!rest[0]) fail("integrations status requires an <integration>");
      return { action: "gateway", endpoint: "status", body: { integration: rest[0] } };
    case "create":
      // `create` is not a gateway call: it POSTs to the registry endpoint
      // (`/api/integrations/`) and the response shape differs from the
      // gateway actions, so it has its own dispatch path below.
      return { action: "create", body: parseIntegrationCreate(rest) };
    default:
      fail(`Unknown integrations command: ${command ?? ""}\n${USAGE}`);
  }
}

/*
 * Build the registry create body from CLI flags.
 *
 *   controller integrations create --name <name> --transport-mode <mode> \\
 *       [--enabled true|false] \\
 *       [--transport-config k=v]... [--transport-header k=v]... [--transport-query k=v]... \\
 *       [--scheme-acquisition <kind> [--scheme-id <id>] \\
 *           [--scheme-attachment <header|query>:<name> [--scheme-attachment-prefix <prefix>]] \\
 *           [--scheme-config k=v]... \\
 *           [--scheme-secret <value> | --scheme-secret=- | --scheme-secret-file <path>]]...
 *
 * The scheme flags form a small "block" grammar: `--scheme-acquisition`
 * starts a new block and consumes every following `--scheme-*` flag until
 * the next `--scheme-acquisition` or end of args. We split on acquisition
 * boundaries first, then parse each block in isolation. This keeps the
 * parser linear in argv length and means a user mistake in one scheme
 * (e.g. a bad attachment) doesn't lose the others.
 */
function parseIntegrationCreate(rest) {
  // Walk argv once, popping top-level flags + their values into the
  // top-level record, and accumulating any `--scheme-*` arg into a
  // pending list. We treat `--scheme-acquisition` as a hard block
  // boundary: it flushes the pending scheme args into a new block
  // (if the prior block is non-empty) and the next non-scheme arg
  // starts the new block's content. This keeps the parser linear in
  // argv length and means a typo in one scheme doesn't lose the others.
  const name = { value: undefined };
  const transportMode = { value: undefined };
  const enabled = { value: undefined };
  const transport = { config: {}, headers: {}, query: {} };

  // Flags whose `--flag=value` shorthand the parser accepts. The value
  // is whatever follows the first `=`. For `--scheme-secret=-` the value
  // is the literal "-" (a sentinel for stdin), not a missing token — so
  // splitting in argv before the value-consumer runs is exactly the
  // shape we need. Transport pair flags (`--transport-config k=v`, ...)
  // are listed too so users can write `--transport-config=baseUrl=...`
  // in shells that prefer the `=` form.
  const EQUALS_FORM_FLAGS = new Set([
    "--name",
    "--enabled",
    "--transport-mode",
    "--transport-config",
    "--transport-header",
    "--transport-query",
    "--scheme-acquisition",
    "--scheme-id",
    "--scheme-attachment",
    "--scheme-attachment-prefix",
    "--scheme-config",
    "--scheme-secret",
    "--scheme-secret-file",
  ]);
  // `=value` shorthand: when the arg is `--flag=value`, split it so the
  // value-consumer sees the flag and value as separate tokens (just like
  // a shell would have if the user had written them as separate args).
  // `parsePairs`-style flags (transport-config, scheme-config) are
  // handled here too: `--transport-config=baseUrl=https://x` becomes
  // `--transport-config baseUrl=https://x`, and the existing key=value
  // parser does the rest.
  rest = expandEqualsForm(rest, EQUALS_FORM_FLAGS);

  const blocks = [];
  let pending = null;
  let lastTopLevelFlag = null;
  let lastSchemeFlag = null;
  // When set, the next non-`--scheme-*` arg is the acquisition kind for
  // the current scheme block. We track this explicitly so the loop doesn't
  // try to route the acquisition value into the top-level value consumer.
  let nextIsSchemeAcquisition = false;

  for (let i = 0; i < rest.length; i += 1) {
    const arg = rest[i];

    if (arg === "--scheme-acquisition") {
      if (pending) blocks.push(pending);
      pending = { args: [] };
      nextIsSchemeAcquisition = true;
      lastTopLevelFlag = null;
      lastSchemeFlag = null;
      continue;
    }

    if (nextIsSchemeAcquisition) {
      // Acquisition value is positional (not a `--scheme-*` flag).
      pending.args.push(arg);
      nextIsSchemeAcquisition = false;
      lastTopLevelFlag = null;
      lastSchemeFlag = null;
      continue;
    }

    // Scheme value-flag: the arg immediately following a `--scheme-*` flag.
    if (lastSchemeFlag) {
      pending.args.push(lastSchemeFlag);
      pending.args.push(arg);
      lastSchemeFlag = null;
      lastTopLevelFlag = null;
      continue;
    }

    // --scheme-* flags (other than --scheme-acquisition) are routed to the
    // scheme buffer of the current block. A scheme flag without a prior
    // --scheme-acquisition is a user error.
    if (arg.startsWith("--scheme-")) {
      if (!pending) {
        fail(`integrations create: ${arg} appeared before any --scheme-acquisition`);
      }
      // Bool-style scheme flags (none today) would skip the next arg here.
      lastSchemeFlag = arg;
      lastTopLevelFlag = null;
      continue;
    }

    // Top-level value: the arg immediately following a top-level
    // value-flag. We track which flag was just consumed so the splitter
    // doesn't mistake a positional value (e.g. the name) for a flag.
    if (lastTopLevelFlag) {
      assignTopLevelValue(lastTopLevelFlag, arg, {
        name,
        transportMode,
        enabled,
        transport,
      });
      lastTopLevelFlag = null;
      continue;
    }

    // Top-level value-flags.
    if (arg === "--name") { lastTopLevelFlag = "--name"; continue; }
    if (arg === "--transport-mode") { lastTopLevelFlag = "--transport-mode"; continue; }
    if (arg === "--enabled") { lastTopLevelFlag = "--enabled"; continue; }
    if (
      arg === "--transport-config" ||
      arg === "--transport-header" ||
      arg === "--transport-query"
    ) {
      lastTopLevelFlag = arg;
      continue;
    }

    // Unknown flag: surface a clear error so the user can fix it.
    if (arg.startsWith("--")) {
      fail(`integrations create: unexpected flag "${arg}"`);
    }
    fail(`integrations create: unexpected positional argument "${arg}"`);
  }
  if (pending) blocks.push(pending);

  // Validate required fields now that the top-level walk is done.
  const trimmedName = (name.value ?? "").trim();
  if (!trimmedName) fail("integrations create requires --name <name>");
  if (!transportMode.value) fail("integrations create requires --transport-mode <mode>");
  if (!INTEGRATION_MODES.includes(transportMode.value)) {
    fail(
      `integrations create: --transport-mode must be one of ${INTEGRATION_MODES.join("|")} (got "${transportMode.value}")`
    );
  }

  if (blocks.length === 0) {
    fail("integrations create requires at least one --scheme-acquisition <kind> block");
  }

  return {
    name: trimmedName,
    ...(enabled.value !== undefined ? { enabled: enabled.value } : {}),
    transport: {
      mode: transportMode.value,
      config: transport.config,
      headers: transport.headers,
      query: transport.query,
    },
    auth: { schemes: blocks.map(parseSchemeBlock) },
  };
}

/*
 * Accept `--flag=value` as a shorthand for `--flag value` for the
 * documented top-level and scheme flags. The shell hands us a single
 * token (`--scheme-secret=-` is one token, not two), and the value-
 * consumer arms of the main parser only look for the bare flag — so
 * without this expansion the `=` form silently dropped on the floor.
 * For `parsePairs`-style flags (`--transport-config=baseUrl=...`,
 * `--scheme-config=clientId=abc`) the value side still contains a `=`,
 * which is fine: we only split on the first `=` between the known
 * flag and the rest, then the per-flag key=value parser does its job.
 */
function expandEqualsForm(argv, flags) {
  const out = [];
  for (const arg of argv) {
    if (typeof arg !== "string" || !arg.startsWith("--")) { out.push(arg); continue; }
    const eq = arg.indexOf("=");
    if (eq <= 0) { out.push(arg); continue; }
    const flag = arg.slice(0, eq);
    if (!flags.has(flag)) { out.push(arg); continue; }
    out.push(flag);
    out.push(arg.slice(eq + 1));
  }
  return out;
}

function assignTopLevelValue(flag, value, refs) {
  if (flag === "--name") refs.name.value = value;
  else if (flag === "--transport-mode") refs.transportMode.value = value;
  else if (flag === "--enabled") {
    if (value !== "true" && value !== "false") {
      fail('integrations create: --enabled must be "true" or "false"');
    }
    refs.enabled.value = value === "true";
  } else if (flag === "--transport-config") {
    const eq = value.indexOf("=");
    if (eq > 0) refs.transport.config[value.slice(0, eq)] = value.slice(eq + 1);
  } else if (flag === "--transport-header") {
    const eq = value.indexOf("=");
    if (eq > 0) refs.transport.headers[value.slice(0, eq)] = value.slice(eq + 1);
  } else if (flag === "--transport-query") {
    const eq = value.indexOf("=");
    if (eq > 0) refs.transport.query[value.slice(0, eq)] = value.slice(eq + 1);
  }
}

/* Parse a single `--scheme-*` block (the slice after `--scheme-acquisition <kind>`). */
function parseSchemeBlock(block) {
  const args = block.args;
  const acquisition = args[0];
  if (!acquisition) fail("integrations create: --scheme-acquisition requires a <kind>");
  if (!INTEGRATION_ACQUISITIONS.includes(acquisition)) {
    fail(
      `integrations create: --scheme-acquisition must be one of ${INTEGRATION_ACQUISITIONS.join("|")} (got "${acquisition}")`
    );
  }

  // Strip the acquisition token so the rest of the helpers see the
  // scheme-internal flags (--scheme-id, --scheme-attachment, ...).
  const inner = args.slice(1);

  const id = flagValue(inner, "--scheme-id");
  const config = parsePairs(inner, "--scheme-config");

  // `--scheme-attachment` uses the form `header:Authorization` /
  // `query:api_key`. We parse it here so the agent gets a clear error
  // on a malformed value before the server sees it.
  let attachment;
  const rawAttachment = flagValue(inner, "--scheme-attachment");
  if (rawAttachment !== undefined) {
    if (NON_ATTACHABLE_ACQUISITIONS.has(acquisition)) {
      fail(
        `integrations create: --scheme-attachment is not valid for acquisition "${acquisition}" (hmac/mtls/cloud don't carry an attachable credential)`
      );
    }
    const colon = rawAttachment.indexOf(":");
    if (colon <= 0 || colon === rawAttachment.length - 1) {
      fail(
        `integrations create: --scheme-attachment must be in the form <header|query>:<name> (got "${rawAttachment}")`
      );
    }
    const kind = rawAttachment.slice(0, colon);
    const name = rawAttachment.slice(colon + 1);
    if (kind !== "header" && kind !== "query") {
      fail(
        `integrations create: --scheme-attachment kind must be "header" or "query" (got "${kind}")`
      );
    }
    const prefix = flagValue(inner, "--scheme-attachment-prefix");
    attachment = { kind, name, ...(prefix ? { prefix } : {}) };
  }

  // Secret resolution: --scheme-secret-file / --scheme-secret=- (stdin) /
  // --scheme-secret <value>. The file/stdin reads are deferred to the
  // async run path so this parser stays synchronous; the dispatcher reads
  // them after parseIntegrations returns and patches the secret onto the
  // body before the POST.
  const secretValue = flagValue(inner, "--scheme-secret");
  const secretFile = flagValue(inner, "--scheme-secret-file");
  if (secretValue !== undefined && secretFile !== undefined) {
    fail(
      "integrations create: --scheme-secret and --scheme-secret-file are mutually exclusive on a single scheme block"
    );
  }
  let secret;
  let secretSource = null;
  if (secretFile !== undefined) {
    secret = ""; // sentinel: dispatcher reads the file
    secretSource = { kind: "file", path: secretFile };
  } else if (secretValue !== undefined) {
    if (secretValue === "-") {
      secret = "";
      secretSource = { kind: "stdin" };
    } else {
      secret = secretValue;
    }
  }

  return {
    ...(id ? { id } : {}),
    acquisition,
    ...(attachment ? { attachment } : {}),
    ...(Object.keys(config).length > 0 ? { config } : {}),
    ...(secretSource || secret !== undefined ? { secret } : {}),
    ...(secretSource ? { __secretSource: secretSource } : {}),
  };
}

export function printIntegrations(command, result) {
  if (command === "list") {
    const conns = result.connections ?? [];
    if (conns.length === 0) return process.stdout.write("No integrations are enabled for this session.\n");
    for (const c of conns) process.stdout.write(`${c.name}  [${c.mode}/${c.kind}]  ${c.summary}\n`);
    return;
  }
  if (command === "list --all") {
    // The registry endpoint returns the connection array directly (not
    // wrapped in `{ connections: [...] }` like the gateway does), so
    // accept both shapes for forward compatibility.
    const conns = Array.isArray(result?.connections)
      ? result.connections
      : Array.isArray(result)
      ? result
      : [];
    if (conns.length === 0) return process.stdout.write("No integrations are configured.\n");
    if (result.json) {
      process.stdout.write(`${JSON.stringify(conns, null, 2)}\n`);
      return;
    }
    for (const c of conns) {
      const state = c.enabled ? "enabled" : "disabled";
      process.stdout.write(`${c.id}  ${c.name}  [${state}]  ${c.transport?.mode ?? "?"}\n`);
    }
    return;
  }
  if (command === "search") {
    const matches = result.matches ?? [];
    if (matches.length === 0) return process.stdout.write("No matching tools.\n");
    for (const m of matches) process.stdout.write(`${m.integration}  ${m.tool} — ${m.summary}\n`);
    return;
  }
  if (command === "tools") {
    if (result.note) process.stdout.write(`${result.note}\n`);
    for (const t of result.tools ?? []) process.stdout.write(`${t.tool} — ${t.summary}\n`);
    return;
  }
  if (command === "describe") return process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
  if (command === "status") {
    process.stdout.write(`${result.message}\n`);
    if (result.ok === false) process.exit(2);
    return;
  }
  // call / request
  if (result.ok === false) {
    if (result.reauth) {
      process.stdout.write(`Re-authentication needed: ${result.reauth.message}\n`);
      process.exit(3);
    }
    fail(result.error || "Request failed");
  }
  if (result.result !== undefined) return process.stdout.write(`${JSON.stringify(result.result, null, 2)}\n`);
  process.stdout.write(`HTTP ${result.status} ${result.statusText}\n`);
  if (result.body) process.stdout.write(`${result.body}\n`);
  if (result.truncated) process.stdout.write("\n[output truncated]\n");
}

// --- skills surface (issue #134) ---

function parseSkills(argv) {
  const [command, ...rest] = argv;
  switch (command) {
    case "list":
      return { endpoint: "list", body: {} };
    case "search": {
      const query = rest.join(" ").trim();
      if (!query) fail("skills search requires a <query>");
      return { endpoint: "search", body: { query } };
    }
    case "describe":
      if (!rest[0]) fail("skills describe requires a <name>");
      return { endpoint: "describe", body: { name: rest[0] } };
    case "activate":
      if (!rest[0]) fail("skills activate requires a <name>");
      return { endpoint: "activate", body: { name: rest[0] } };
    case "import-discover":
      return { endpoint: "import-discover", body: {} };
    case "import":
      return { endpoint: "import", body: parseImportSelections(rest) };
    default:
      fail(`Unknown skills command: ${command ?? ""}\n${USAGE}`);
  }
}

function parseImportSelections(rest) {
  // `--all` is a CLI convenience: the server treats an empty `selections`
  // array as "nothing to import", so when `--all` is set we return a marker
  // and let `runSkills` fetch the discover list and build the selections
  // before hitting the import endpoint. The `--overwrite` flag still
  // applies in bulk mode, so we record it on the marker and forward it to
  // every generated selection below.
  if (rest.includes("--all")) {
    return { __all: true, overwrite: rest.includes("--overwrite") };
  }
  const provider = flagValue(rest, "--provider");
  const source = flagValue(rest, "--source");
  const scope = flagValue(rest, "--scope") ?? "user";
  if (!provider || !source) {
    fail("skills import requires --provider <id> and --source <path> (or --all)");
  }
  const overwrite = rest.includes("--overwrite");
  return {
    selections: [{ providerId: provider, sourcePath: source, scope, overwrite }],
  };
}

function printSkills(command, result) {
  if (command === "list") {
    const skills = result.skills ?? [];
    if (skills.length === 0) return process.stdout.write("No unified skills are configured.\n");
    for (const s of skills) process.stdout.write(`${s.name} — ${s.description}\n`);
    return;
  }
  if (command === "search") {
    const skills = result.skills ?? [];
    if (skills.length === 0) return process.stdout.write("No matching unified skills.\n");
    for (const s of skills) process.stdout.write(`${s.name} — ${s.description}\n`);
    return;
  }
  if (command === "describe") {
    process.stdout.write(result.body ?? "");
    return;
  }
  if (command === "activate") {
    process.stdout.write(`${result.message ?? "Skill activated for the next turn."}\n`);
    return;
  }
  if (command === "import-discover") {
    const skills = result.skills ?? [];
    if (skills.length === 0) return process.stdout.write("No importable per-agent skills found.\n");
    for (const s of skills) {
      const project = s.projectPath ? `  (project: ${s.projectPath})` : "";
      process.stdout.write(`${s.providerId}/${s.scope}  ${s.name} — ${s.description}${project}\n`);
      // Print the source path so the single-skill import flow
      // (`import --provider <id> --source <path>`) has the value it needs.
      process.stdout.write(`  source: ${s.sourcePath}\n`);
    }
    return;
  }
  if (command === "import") {
    const results = result.results ?? [];
    if (results.length === 0) return process.stdout.write("Nothing to import.\n");
    for (const r of results) {
      const status = r.status.toUpperCase().padEnd(8);
      const where = `${r.providerId}/${r.scope}`;
      const name = r.name || "(unknown)";
      const tail = r.reason ? ` — ${r.reason}` : "";
      process.stdout.write(`${status} ${where.padEnd(12)} ${name}${tail}\n`);
    }
    return;
  }
}

async function runSkills(argv, serverUrl) {
  const { endpoint, body } = parseSkills(argv);
  let effectiveBody = body;
  // `--all` is a CLI convenience: fetch the discover list, then import every
  // entry. Skips/failures are surfaced per-skill by the server response.
  if (body && body.__all) {
    const discover = await postJson(serverUrl, "/api/skills/import-discover", {});
    if (discover.response.status >= 400) {
      fail(serverError(discover.result, `Import discovery failed (HTTP ${discover.response.status})`));
    }
    const selections = (discover.result?.skills ?? []).map((s) => ({
      providerId: s.providerId,
      sourcePath: s.sourcePath,
      scope: s.scope,
      overwrite: body.overwrite === true,
    }));
    effectiveBody = { selections };
  }
  const { response, result } = await postJson(serverUrl, `/api/skills/${endpoint}`, effectiveBody);
  if (response.status >= 400 && result && result.error) fail(result.error);
  printSkills(argv[0], result);
}

// --- integrations dispatcher (issue #178) ---
//
// Bridges `parseIntegrations` to the right wire call. There are three
// action kinds today:
//   - `gateway`         POST /api/integrations/gateway/<endpoint>   (list/search/call/...)
//   - `registry-list`   GET  /api/integrations/                    (list --all)
//   - `create`          POST /api/integrations/                    (create)
//
// `gateway` is the historical surface; the registry routes are mounted on
// `/api/integrations/` (same one the Settings dialog uses) and have a
// different request/response shape, so they get their own branch.
export async function runIntegrations(argv, serverUrl) {
  const parsed = parseIntegrations(argv);
  if (parsed.action === "gateway") {
    const { response, result } = await postJson(
      serverUrl,
      `/api/integrations/gateway/${parsed.endpoint}`,
      parsed.body
    );
    if (response.status >= 400 && result && result.error) fail(result.error);
    printIntegrations(argv[0], result);
    return;
  }
  if (parsed.action === "registry-list") {
    const { response, result } = await getJson(serverUrl, "/api/integrations/");
    if (response.status >= 400) {
      fail(serverError(result, `Failed to list integrations (HTTP ${response.status})`));
    }
    // The registry endpoint returns the connection array directly (not
    // wrapped in `{ connections: [...] }` like the gateway does). Wrap it
    // here so `printIntegrations` can use a single shape and the `--json`
    // flag renders the array rather than the full HTTP envelope.
    const conns = Array.isArray(result) ? result : result?.connections ?? [];
    printIntegrations("list --all", { connections: conns, json: parsed.body.json });
    return;
  }
  if (parsed.action === "create") {
    await runIntegrationsCreate(serverUrl, parsed.body);
    return;
  }
  fail(`Unknown integrations action: ${parsed.action}`);
}

/*
 * Resolve secret sources in the create body and POST to the registry.
 *
 * The synchronous parser leaves a `__secretSource` sentinel on each scheme
 * whose value must be read at submit time (file or stdin). We do that here
 * because the parser must stay synchronous and the file read is async. After
 * resolution, we strip the sentinel so it never reaches the wire.
 */
async function runIntegrationsCreate(serverUrl, body) {
  const schemes = body?.auth?.schemes;
  if (Array.isArray(schemes)) {
    for (const scheme of schemes) {
      if (!scheme || !scheme.__secretSource) continue;
      const source = scheme.__secretSource;
      delete scheme.__secretSource;
      if (source.kind === "file") {
        try {
          const fs = await import("node:fs/promises");
          scheme.secret = (await fs.readFile(source.path, "utf-8")).replace(/\r?\n$/, "");
        } catch (error) {
          fail(`Could not read --scheme-secret-file ${source.path}: ${error?.message ?? error}`);
        }
      } else if (source.kind === "stdin") {
        // Read stdin until EOF, strip a single trailing newline so the common
        // `echo "$TOKEN" | controller ...` idiom doesn't pick up an extra \n.
        // Real stdin yields Buffer chunks; `Readable.from([...])` in tests
        // can yield either, so coerce to Buffer here to keep the concat path
        // uniform.
        const chunks = [];
        for await (const chunk of process.stdin) {
          chunks.push(typeof chunk === "string" ? Buffer.from(chunk) : chunk);
        }
        scheme.secret = Buffer.concat(chunks).toString("utf-8").replace(/\r?\n$/, "");
      }
    }
  }
  const { response, result } = await postJson(serverUrl, "/api/integrations/", body);
  if (response.status >= 400) {
    fail(serverError(result, `Failed to create integration (HTTP ${response.status})`));
  }
  const name = result?.name ?? body?.name ?? "(unnamed)";
  const id = result?.id ?? "(no id)";
  const mode = result?.transport?.mode ?? body?.transport?.mode ?? "?";
  const state = result?.enabled === false ? "  [disabled]" : "";
  process.stdout.write(`Created integration ${name} (id=${id}) [mode=${mode}]${state}\n`);
}

// `create` does not fit the `parseSkills` shape because it takes
// `--name` / `--description` / `--body` / `--body-file` flags and reads
// from disk when given a body file. It also POSTs to a different endpoint
// that returns `{ ok, skill }` instead of the bare payload.
async function readBodyFile(path) {
  const fs = await import("node:fs/promises");
  return fs.readFile(path, "utf-8");
}

function parseFlags(rest, flags) {
  const out = {};
  for (let i = 0; i < rest.length; i += 1) {
    if (flags.includes(rest[i]) && rest[i + 1] !== undefined) {
      out[rest[i].slice(2)] = rest[i + 1];
      i += 1;
    }
  }
  return out;
}

async function runSkillsCreate(rest, serverUrl) {
  const flags = parseFlags(rest, ["--name", "--description", "--body", "--body-file"]);
  if (!flags.name) fail("skills create requires --name <name>");
  if (!flags.description) fail("skills create requires --description <description>");
  if (flags["body-file"] && flags.body) {
    fail("skills create accepts only one of --body or --body-file");
  }
  let body = "";
  if (flags["body-file"]) {
    try {
      body = await readBodyFile(flags["body-file"]);
    } catch (error) {
      fail(`Could not read body file: ${error?.message ?? error}`);
    }
  } else if (flags.body !== undefined) {
    body = flags.body;
  }
  const { response, result } = await postJson(serverUrl, "/api/skills/create", {
    name: flags.name,
    description: flags.description,
    body,
  });
  if (!result || result.ok === false) {
    fail(serverError(result, `Skill create failed (HTTP ${response.status})`));
  }
  const skill = result.skill ?? {};
  process.stdout.write(`Created skill "${skill.name}" at ${skill.path}\n`);
}

async function main() {
  const [surface, ...rest] = process.argv.slice(2);
  if (!surface || surface === "-h" || surface === "--help") {
    process.stdout.write(`${USAGE}\n`);
    process.exit(surface ? 0 : 1);
  }
  if (
    surface !== "browser" &&
    surface !== "terminal" &&
    surface !== "integrations" &&
    surface !== "skills" &&
    surface !== "projects" &&
    surface !== "worktrees" &&
    surface !== "sessions" &&
    surface !== "schedules" &&
    surface !== "memory"
  ) {
    fail(`Unknown surface: ${surface}\n${USAGE}`);
  }
  const serverUrl = await getServerUrl();
  if (surface === "browser") await runBrowser(rest, serverUrl);
  else if (surface === "terminal") await runTerminal(rest, serverUrl);
  else if (surface === "integrations") await runIntegrations(rest, serverUrl);
  else if (surface === "skills") {
    if (rest[0] === "create") {
      await runSkillsCreate(rest.slice(1), serverUrl);
    } else {
      await runSkills(rest, serverUrl);
    }
  } else if (surface === "projects") {
    await runProjects(rest, serverUrl);
  } else if (surface === "worktrees") {
    await runWorktrees(rest, serverUrl);
  } else if (surface === "sessions") {
    await runSessions(rest, serverUrl);
  } else if (surface === "schedules") {
    await runSchedules(rest, serverUrl);
  } else if (surface === "memory") {
    await runMemory(rest, serverUrl);
  }
}

if (isMain) {
  main().catch((error) => fail(error?.message ?? String(error)));
}
